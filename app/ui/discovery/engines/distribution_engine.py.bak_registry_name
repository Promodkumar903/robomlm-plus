def build_distribution_window(
    input_data: DistributionInput,
) -> DistributionWindow:
    """
    Build descriptive statistics for the observation window.

    IMPORTANT:
    These values are descriptive observations only.
    They are NOT a distribution score or distribution classification.
    """

    validation = validate_distribution_input(input_data)

    if not validation["valid"]:
        raise ValueError(
            "Cannot build distribution window from invalid input: "
            + "; ".join(validation["errors"])
        )

    observation_count = validation["observation_count"]

    closes = list(input_data.closes)
    highs = list(input_data.highs)
    lows = list(input_data.lows)
    volumes = list(input_data.volumes)

    first_close = closes[0] if closes else None
    last_close = closes[-1] if closes else None

    highest_price = max(highs) if highs else None
    lowest_price = min(lows) if lows else None

    total_volume = (
        float(sum(volumes))
        if volumes
        else None
    )

    average_volume = (
        float(total_volume / len(volumes))
        if volumes and total_volume is not None
        else None
    )

    start_timestamp = (
        input_data.timestamps[0]
        if input_data.timestamps
        else None
    )

    end_timestamp = (
        input_data.timestamps[-1]
        if input_data.timestamps
        else None
    )

    return DistributionWindow(
        observation_count=observation_count,
        first_close=first_close,
        last_close=last_close,
        highest_price=highest_price,
        lowest_price=lowest_price,
        total_volume=total_volume,
        average_volume=average_volume,
        start_timestamp=start_timestamp,
        end_timestamp=end_timestamp,
        metadata={
            "descriptive_only": True,
            "distribution_classification_generated": False,
        },
    )


