def run_distribution_engine(
    request: DistributionEngineRequest,
    *,
    registry: Optional[DistributionFormulaRegistry] = None,
) -> DistributionEngineResult:
    """
    Execute a Distribution Engine request.

    Exactly one execution mode is selected:
        single timeframe
        OR
        multi-timeframe
    """

    if not isinstance(
        request,
        DistributionEngineRequest,
    ):
        return DistributionEngineResult(
            status=DistributionStatus.INVALID,
            errors=[
                "request must be DistributionEngineRequest"
            ],
            metadata={
                "engine": DISTRIBUTION_ENGINE,
                "execution": False,
            },
        )

    has_single = request.input_data is not None
    has_mtf = request.multi_timeframe_input is not None

    if not has_single and not has_mtf:
        return DistributionEngineResult(
            status=DistributionStatus.INSUFFICIENT_DATA,
            warnings=[
                "No Distribution Engine input supplied"
            ],
            metadata={
                "engine": DISTRIBUTION_ENGINE,
                "execution": False,
            },
        )

    if has_single and has_mtf:
        return DistributionEngineResult(
            status=DistributionStatus.INVALID,
            errors=[
                "Provide either input_data or "
                "multi_timeframe_input, not both"
            ],
            metadata={
                "engine": DISTRIBUTION_ENGINE,
                "execution": False,
            },
        )

    if has_mtf:
        return analyze_multitimeframe_distribution(
            request.multi_timeframe_input,
            formula_map=request.formula_map,
            formula_version_map=request.formula_version_map,
            registry=registry,
        )

    return analyze_distribution(
        request.input_data,
        formula_id=request.formula_id,
        formula_version=request.formula_version,
        registry=registry,
    )


