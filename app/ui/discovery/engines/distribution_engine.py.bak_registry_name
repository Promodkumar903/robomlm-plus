def create_distribution_request(
    input_data: Optional[DistributionInput] = None,
    multi_timeframe_input: Optional[MultiTimeframeDistributionInput] = None,
    formula_id: Optional[str] = None,
    formula_version: Optional[str] = None,
    formula_map: Optional[Mapping[Timeframe, str]] = None,
    formula_version_map: Optional[Mapping[Timeframe, str]] = None,
    metadata: Optional[Mapping[str, Any]] = None,
) -> DistributionEngineRequest:
    """
    Create an explicit distribution-engine request.

    Formula selection remains explicit.
    No default or guessed formula is inserted.
    """

    return DistributionEngineRequest(
        input_data=input_data,
        multi_timeframe_input=multi_timeframe_input,
        formula_id=formula_id,
        formula_version=formula_version,
        formula_map=dict(formula_map or {}),
        formula_version_map=dict(formula_version_map or {}),
        metadata=dict(metadata or {}),
    )


def execute_distribution_request(
    request: DistributionEngineRequest,
    registry: Optional[DistributionFormulaRegistry] = None,
) -> DistributionEngineResult:
    """
    Execute a DistributionEngineRequest.

    Exactly one analysis path is allowed:
        single timeframe OR multi-timeframe.
    """

    if not isinstance(request, DistributionEngineRequest):
        return DistributionEngineResult(
            status=DistributionStatus.INVALID,
            instrument_id=None,
            symbol=None,
            research_validated=False,
            errors=["request must be DistributionEngineRequest"],
            metadata={"request_type_valid": False},
        )

    if request.input_data is not None and request.multi_timeframe_input is not None:
        return DistributionEngineResult(
            status=DistributionStatus.INVALID,
            instrument_id=None,
            symbol=None,
            research_validated=False,
            errors=["request cannot contain both input_data and multi_timeframe_input"],
            metadata={"request_mode": "CONFLICTING"},
        )

    if request.multi_timeframe_input is not None:
        return run_distribution_engine(
            multi_timeframe_input=request.multi_timeframe_input,
            formula_map=request.formula_map,
            formula_version_map=request.formula_version_map,
            registry=registry,
        )

    if request.input_data is not None:
        return run_distribution_engine(
            input_data=request.input_data,
            formula_id=request.formula_id,
            formula_version=request.formula_version,
            registry=registry,
        )

    return DistributionEngineResult(
        status=DistributionStatus.INSUFFICIENT_DATA,
        instrument_id=None,
        symbol=None,
        research_validated=False,
        warnings=["no distribution input supplied"],
        metadata={"request_mode": "EMPTY"},
    )


