def _serialize_distribution_value(value: Any) -> Any:
    """
    Recursively convert Distribution Engine objects into JSON-safe values.
    """

    if isinstance(value, Enum):
        return value.value

    if isinstance(value, Mapping):
        return {
            str(key): _serialize_distribution_value(item)
            for key, item in value.items()
        }

    if isinstance(value, (list, tuple, set)):
        return [
            _serialize_distribution_value(item)
            for item in value
        ]

    if hasattr(value, "__dataclass_fields__"):
        return {
            field_name: _serialize_distribution_value(
                getattr(value, field_name)
            )
            for field_name in value.__dataclass_fields__
        }

    return value


