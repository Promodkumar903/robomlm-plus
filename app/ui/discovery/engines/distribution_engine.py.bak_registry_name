@dataclass
class DistributionEngineHealth:
    """
    Operational health state of Distribution Engine.

    Operational != intelligence available.

    A healthy engine can legitimately report that no validated research
    formula is currently available.
    """

    engine: str = DISTRIBUTION_ENGINE
    version: str = DISTRIBUTION_ENGINE_VERSION

    operational: bool = False
    authority_valid: bool = False

    input_normalization_available: bool = True
    multi_timeframe_available: bool = True

    formula_registry_available: bool = False
    validated_formula_available: bool = False

    research_formula_required: bool = True
    research_formula_generated_here: bool = False

    distribution_intelligence_generated: bool = False

    opportunity_generation: bool = False
    decision_generation: bool = False
    d13_generation: bool = False
    risk_generation: bool = False
    cas_generation: bool = False
    execution_generation: bool = False

    warnings: List[str] = field(default_factory=list)
    errors: List[str] = field(default_factory=list)

    metadata: Dict[str, Any] = field(default_factory=dict)


# =============================================================================
# HEALTH BUILDER
# =============================================================================

def build_distribution_engine_health(
    *,
    registry: Optional[DistributionFormulaRegistry] = None,
    result: Optional[DistributionEngineResult] = None,
) -> DistributionEngineHealth:
    """
    Build current Distribution Engine health state.
    """

    active_registry = (
        registry
        if registry is not None
        else get_distribution_formula_registry()
    )

    authority = validate_distribution_authority()

    warnings: List[str] = []
    errors: List[str] = []

    validated_formula_available = False

    for descriptor in active_registry.descriptors():

        if (
            descriptor.enabled
            and descriptor.validated
        ):
            validated_formula_available = True
            break

    integrity = validate_distribution_engine_integrity(
        result=result,
        registry=active_registry,
    )

    warnings.extend(
        integrity["warnings"]
    )

    errors.extend(
        integrity["errors"]
    )

    intelligence_generated = bool(
        result is not None
        and (
            result.analysis is not None
            or result.multi_timeframe is not None
        )
        and result.research_validated
    )

    return DistributionEngineHealth(
        engine=DISTRIBUTION_ENGINE,
        version=DISTRIBUTION_ENGINE_VERSION,
        operational=bool(
            authority["valid"]
            and not errors
        ),
        authority_valid=authority["valid"],
        input_normalization_available=True,
        multi_timeframe_available=True,
        formula_registry_available=True,
        validated_formula_available=(
            validated_formula_available
        ),
        research_formula_required=True,
        research_formula_generated_here=False,
        distribution_intelligence_generated=(
            intelligence_generated
        ),
        opportunity_generation=False,
        decision_generation=False,
        d13_generation=False,
        risk_generation=False,
        cas_generation=False,
        execution_generation=False,
        warnings=warnings,
        errors=errors,
        metadata={
            "registry_size": len(active_registry),
            "intelligence_available": (
                validated_formula_available
            ),
            "result_supplied": result is not None,
            "engine_generated_formula": False,
            "upstream_truth_preserved": True,
        },
    )


