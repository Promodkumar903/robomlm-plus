        "operational": (
            distribution_engine_operational_check(
                registry=active_registry
            )
        ),
        "health": serialize_distribution_engine_health(
            health
        ),
        "formula_registry": {
            "size": len(active_registry),
            "descriptors": descriptors,
        },
        "result_validation": result_validation,
    }


