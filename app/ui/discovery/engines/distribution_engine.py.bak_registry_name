def _normalize_distribution_series(
    values: Optional[Sequence[Any]],
) -> List[float]:
    """
    Normalize a numerical market-data series.

    No intelligence is calculated here.
    """

    if values is None:
        return []

    normalized: List[float] = []

    for value in values:
        if value is None:
            continue

        try:
            normalized.append(float(value))
        except (TypeError, ValueError):
            raise ValueError(
                f"Invalid numerical market-data value: {value!r}"
            )

    return normalized


def _normalize_distribution_timestamps(
    timestamps: Optional[Sequence[Any]],
) -> List[Any]:
    """
    Preserve timestamp objects while normalizing container shape.
    """

    if timestamps is None:
        return []

    return list(timestamps)


def normalize_distribution_input(
    input_data: DistributionInput,
) -> DistributionInput:
    """
    Normalize DistributionInput into a deterministic internal representation.

    This function does NOT:
        - calculate distribution
        - infer accumulation
        - infer breakout
        - generate signals
        - generate decisions
    """

    if not isinstance(input_data, DistributionInput):
        raise TypeError(
            "normalize_distribution_input expects DistributionInput"
        )

    return replace(
        input_data,
        instrument_id=str(input_data.instrument_id).strip(),
        symbol=str(input_data.symbol).strip(),
        asset_class=str(input_data.asset_class).strip(),
        market_id=str(input_data.market_id).strip(),
        exchange=(
            str(input_data.exchange).strip()
            if input_data.exchange is not None
            else None
        ),
        timestamps=_normalize_distribution_timestamps(
            input_data.timestamps
        ),
        opens=_normalize_distribution_series(
            input_data.opens
        ),
        highs=_normalize_distribution_series(
            input_data.highs
        ),
        lows=_normalize_distribution_series(
            input_data.lows
        ),
        closes=_normalize_distribution_series(
            input_data.closes
        ),
        volumes=_normalize_distribution_series(
            input_data.volumes
        ),
        structure_context=(
            dict(input_data.structure_context)
            if input_data.structure_context is not None
            else None
        ),
        source=(
            str(input_data.source).strip()
            if input_data.source is not None
            else None
        ),
        metadata=dict(input_data.metadata),
    )


def normalize_multitimeframe_distribution_input(
    input_data: MultiTimeframeDistributionInput,
) -> MultiTimeframeDistributionInput:
    """
    Normalize all timeframe-specific DistributionInput objects.
    """

    if not isinstance(
        input_data,
        MultiTimeframeDistributionInput,
    ):
        raise TypeError(
            "normalize_multitimeframe_distribution_input expects "
            "MultiTimeframeDistributionInput"
        )

    normalized_inputs: Dict[
        Timeframe,
        DistributionInput,
    ] = {}

    for timeframe, distribution_input in input_data.inputs.items():

        if not isinstance(timeframe, Timeframe):
            try:
                timeframe = Timeframe(str(timeframe))
            except ValueError:
                timeframe = Timeframe.UNKNOWN

        normalized_inputs[timeframe] = normalize_distribution_input(
            distribution_input
        )

    requested = []

    for timeframe in input_data.requested_timeframes:
        if isinstance(timeframe, Timeframe):
            requested.append(timeframe)
            continue

        try:
            requested.append(Timeframe(str(timeframe)))
        except ValueError:
            requested.append(Timeframe.UNKNOWN)

    return replace(
        input_data,
        instrument_id=str(input_data.instrument_id).strip(),
        symbol=str(input_data.symbol).strip(),
        inputs=normalized_inputs,
        requested_timeframes=requested,
        metadata=dict(input_data.metadata),
    )


