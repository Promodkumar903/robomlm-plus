def build_distribution_engine_snapshot(
    result: DistributionEngineResult,
) -> DistributionEngineSnapshot:
    """
    Build an immutable audit snapshot from an engine result.
    """

    if not isinstance(
        result,
        DistributionEngineResult,
    ):
        raise TypeError(
            "result must be DistributionEngineResult"
        )

    metadata = dict(result.metadata)

    metadata.update(
        {
            "snapshot_engine": DISTRIBUTION_ENGINE,
            "snapshot_version": DISTRIBUTION_ENGINE_VERSION,
            "research_validated": bool(
                result.research_validated
            ),
            "engine_generated_formula": False,
            "upstream_truth_preserved": True,
        }
    )

    return DistributionEngineSnapshot(
        engine=DISTRIBUTION_ENGINE,
        version=DISTRIBUTION_ENGINE_VERSION,
        instrument_id=result.instrument_id,
        symbol=result.symbol,
        status=result.status,
        formula_id=result.formula_id,
        formula_version=result.formula_version,
        research_validated=result.research_validated,
        analysis=result.analysis,
        multi_timeframe=result.multi_timeframe,
        metadata=tuple(
            sorted(
                metadata.items(),
                key=lambda item: str(item[0]),
            )
        ),
    )


