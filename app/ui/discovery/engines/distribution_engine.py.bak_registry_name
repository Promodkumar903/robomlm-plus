    ):
        errors.append(
            "result cannot contain both single analysis "
            "and multi-timeframe analysis"
        )

    if result.analysis is not None:

        validation = validate_distribution_analysis(
            result.analysis
        )

        if not validation["valid"]:
            errors.extend(
                [
                    f"analysis: {error}"
                    for error in validation["errors"]
                ]
            )

        warnings.extend(
            [
                f"analysis: {warning}"
                for warning in validation["warnings"]
            ]
        )

    if result.multi_timeframe is not None:

        validation = validate_multitimeframe_distribution(
            result.multi_timeframe
        )

        if not validation["valid"]:
            errors.extend(
                [
                    f"multi_timeframe: {error}"
                    for error in validation["errors"]
                ]
            )

        warnings.extend(
            [
                f"multi_timeframe: {warning}"
                for warning in validation["warnings"]
            ]
        )

    if result.research_validated:

        if result.analysis is not None:
            if not result.analysis.research_validated:
                errors.append(
                    "result marked validated but analysis is not validated"
                )

        if result.multi_timeframe is not None:
            if not result.multi_timeframe.research_validated:
                errors.append(
                    "result marked validated but MTF analysis "
                    "is not validated"
                )

    return {
        "valid": not errors,
        "research_validated": bool(
            result.research_validated
        ),
        "errors": errors,
        "warnings": warnings,
    }


# =============================================================================
# FORMULA DESCRIPTOR VALIDATION
# =============================================================================

def validate_distribution_formula_descriptor(
    descriptor: DistributionFormulaDescriptor,
) -> Dict[str, Any]:
    """
    Validate research formula descriptor.
    """

    errors: List[str] = []
    warnings: List[str] = []

    if not isinstance(
        descriptor,
        DistributionFormulaDescriptor,
    ):
        return {
            "valid": False,
            "errors": [
                "descriptor must be DistributionFormulaDescriptor"
            ],
            "warnings": [],
        }

    if not descriptor.formula_id.strip():
        errors.append(
            "formula_id is required"
        )

    if not descriptor.formula_version.strip():
        errors.append(
            "formula_version is required"
        )

    if not descriptor.name.strip():
        errors.append(
            "formula name is required"
        )

    if not descriptor.owner.strip():
        errors.append(
            "formula owner is required"
        )

    if descriptor.validated is False:
        warnings.append(
            "formula descriptor is not research validated"
        )

    if descriptor.enabled and not descriptor.validated:
        warnings.append(
            "enabled formula is not research validated"
        )

    return {
        "valid": not errors,
        "errors": errors,
        "warnings": warnings,
    }


# =============================================================================
# ENGINE INTEGRITY
# =============================================================================

def validate_distribution_engine_integrity(
    result: Optional[DistributionEngineResult] = None,
    *,
    registry: Optional[DistributionFormulaRegistry] = None,
) -> Dict[str, Any]:
    """
    Validate engine-level architectural integrity.
    """

    errors: List[str] = []
    warnings: List[str] = []

    authority = validate_distribution_authority()

    if not authority["valid"]:
        errors.append(
            "Distribution Engine authority validation failed"
        )

    contract = DISTRIBUTION_ENGINE_CONTRACT

    required_contract_keys = (
        "engine",
        "version",
        "name",
        "layer",
        "role",
        "authority_owner",
        "inputs",
        "outputs",
        "formula_policy",
        "downstream_consumers",
        "forbidden_responsibilities",
    )

    for key in required_contract_keys:
        if key not in contract:
            errors.append(
                f"missing contract key: {key}"
            )

    if contract.get("engine") != DISTRIBUTION_ENGINE:
        errors.append(
            "contract engine identifier mismatch"
        )

    if contract.get("version") != DISTRIBUTION_ENGINE_VERSION:
        errors.append(
            "contract version mismatch"
        )

    formula_policy = contract.get(
        "formula_policy",
        {},
    )

    if formula_policy.get(
        "validated_required"
    ) is not True:
        errors.append(
            "validated research formula must be required"
        )

    if formula_policy.get(
        "formula_guessing_allowed"
    ) is not False:
        errors.append(
            "formula guessing must remain disabled"
        )

    if formula_policy.get(
        "default_formula_allowed"
    ) is not False:
        errors.append(
            "default formula selection must remain disabled"
        )

    # -------------------------------------------------------------------------
    # REGISTRY CHECK
    # -------------------------------------------------------------------------

    active_registry = (
        registry
        if registry is not None
        else get_distribution_formula_registry()
    )

    registered_descriptors = (
        active_registry.descriptors()
    )

    invalid_descriptors = []

    for descriptor in registered_descriptors:

        validation = validate_distribution_formula_descriptor(
            descriptor
        )

        if not validation["valid"]:
            invalid_descriptors.append(
                descriptor.formula_id
            )

    if invalid_descriptors:
        errors.append(
            "invalid registered formula descriptors: "
            + ", ".join(invalid_descriptors)
        )

    if not registered_descriptors:
        warnings.append(
            "no Distribution research formula is currently registered"
        )

    # -------------------------------------------------------------------------
    # RESULT CHECK
    # -------------------------------------------------------------------------

    result_validation: Optional[Dict[str, Any]] = None

    if result is not None:

        result_validation = (
            validate_distribution_engine_result(
                result
            )
        )

        if not result_validation["valid"]:
            errors.extend(
                [
                    f"result: {error}"
                    for error in result_validation["errors"]
                ]
            )

        warnings.extend(
            [
                f"result: {warning}"
                for warning in result_validation["warnings"]
            ]
        )

    return {
        "valid": not errors,
        "engine": DISTRIBUTION_ENGINE,
        "version": DISTRIBUTION_ENGINE_VERSION,
        "authority_valid": authority["valid"],
        "registry_size": len(active_registry),
        "registered_formula_count": len(
            registered_descriptors
        ),
        "result_validation": result_validation,
        "errors": errors,
        "warnings": warnings,
    }


