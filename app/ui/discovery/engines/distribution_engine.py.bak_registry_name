class DistributionFormulaProvider(ABC):
    """
    Abstract research-formula provider.

    The Distribution Engine does not invent formulas.
    A validated research provider must implement this interface.
    """

    @abstractmethod
    def describe(self) -> DistributionFormulaDescriptor:
        """
        Return formula metadata and validation status.
        """

        raise NotImplementedError

    @abstractmethod
    def analyze(
        self,
        input_data: DistributionInput,
    ) -> DistributionAnalysis:
        """
        Execute the research-owned distribution formula.
        """

        raise NotImplementedError


# =============================================================================
# FORMULA REGISTRY
# =============================================================================

class DistributionFormulaRegistry:
    """
    Registry for explicit, versioned, research-owned distribution formulas.
    """

    def __init__(self) -> None:
        self._providers: Dict[
            Tuple[str, str],
            DistributionFormulaProvider,
        ] = {}

    def register(
        self,
        provider: DistributionFormulaProvider,
        *,
        replace_existing: bool = False,
    ) -> DistributionFormulaDescriptor:
        """
        Register a formula provider.

        Registration does not mark a formula as validated.
        Validation status comes from the provider descriptor.
        """

        if not isinstance(
            provider,
            DistributionFormulaProvider,
        ):
            raise TypeError(
                "provider must implement DistributionFormulaProvider"
            )

        descriptor = provider.describe()

        if not isinstance(
            descriptor,
            DistributionFormulaDescriptor,
        ):
            raise TypeError(
                "provider.describe() must return "
                "DistributionFormulaDescriptor"
            )

        key = (
            descriptor.formula_id,
            descriptor.formula_version,
        )

        if key in self._providers and not replace_existing:
            raise ValueError(
                "Distribution formula already registered: "
                f"{descriptor.formula_id}@"
                f"{descriptor.formula_version}"
            )

        self._providers[key] = provider

        return descriptor

    def get(
        self,
        formula_id: str,
        formula_version: Optional[str] = None,
    ) -> Optional[DistributionFormulaProvider]:
        """
        Resolve a formula provider by explicit ID/version.
        """

        if formula_version is not None:
            return self._providers.get(
                (
                    str(formula_id),
                    str(formula_version),
                )
            )

        candidates = [
            provider
            for (registered_id, _),
            provider in self._providers.items()
            if registered_id == str(formula_id)
        ]

        if len(candidates) == 1:
            return candidates[0]

        return None

    def unregister(
        self,
        formula_id: str,
        formula_version: str,
    ) -> bool:
        """
        Remove an explicitly registered formula provider.
        """

        key = (
            str(formula_id),
            str(formula_version),
        )

        if key not in self._providers:
            return False

        del self._providers[key]
        return True

    def descriptors(
        self,
    ) -> List[DistributionFormulaDescriptor]:
        """
        Return descriptors for all registered providers.
        """

        return [
            provider.describe()
            for provider in self._providers.values()
        ]

    def clear(self) -> None:
        """
        Clear registry.
        """

        self._providers.clear()

    def __len__(self) -> int:
        return len(self._providers)


