# =============================================================================

def normalize_requested_distribution_timeframes(
    timeframes: Optional[Iterable[Any]],
) -> List[Timeframe]:
    """
    Normalize requested timeframe identifiers.
    """

    if timeframes is None:
        return []

    normalized: List[Timeframe] = []

    for timeframe in timeframes:

        if isinstance(timeframe, Timeframe):
            normalized.append(timeframe)
            continue

        try:
            normalized.append(
                Timeframe(str(timeframe).upper())
            )
        except ValueError:
            normalized.append(
                Timeframe.UNKNOWN
            )

    return normalized


def build_multitimeframe_distribution_input(
    instrument_id: str,
    symbol: str,
    inputs: Mapping[Any, DistributionInput],
    requested_timeframes: Optional[Iterable[Any]] = None,
    metadata: Optional[Mapping[str, Any]] = None,
) -> MultiTimeframeDistributionInput:
    """
    Build a multi-timeframe Distribution input contract.
    """

    normalized_inputs: Dict[
        Timeframe,
        DistributionInput,
    ] = {}

    for timeframe, distribution_input in inputs.items():

        if not isinstance(timeframe, Timeframe):
            try:
                timeframe = Timeframe(str(timeframe).upper())
            except ValueError:
                timeframe = Timeframe.UNKNOWN

        normalized_inputs[timeframe] = normalize_distribution_input(
            distribution_input
        )

    requested = normalize_requested_distribution_timeframes(
        requested_timeframes
    )

    return MultiTimeframeDistributionInput(
        instrument_id=str(instrument_id).strip(),
        symbol=str(symbol).strip(),
        inputs=normalized_inputs,
        requested_timeframes=requested,
        metadata=dict(metadata or {}),
    )


