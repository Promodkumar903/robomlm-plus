# =============================================================================
# SINGLE-TIMEFRAME DISTRIBUTION ANALYSIS
# =============================================================================

def analyze_distribution(
    input_data: DistributionInput,
    *,
    formula_id: Optional[str] = None,
    formula_version: Optional[str] = None,
    registry: Optional[DistributionFormulaRegistry] = None,
) -> DistributionEngineResult:
    """
    Execute a research-owned Distribution Formula against normalized input.

    IMPORTANT:
    The Distribution Engine itself does not calculate or invent the
    distribution intelligence formula.

    A validated upstream provider MUST supply:
        state
        direction
        phase
        strength
        confidence
        measurements
    """

    warnings: List[str] = []
    errors: List[str] = []

    # -------------------------------------------------------------------------
    # INPUT TYPE
    # -------------------------------------------------------------------------

    if not isinstance(input_data, DistributionInput):
        return DistributionEngineResult(
            status=DistributionStatus.INVALID,
            errors=[
                "input_data must be DistributionInput"
            ],
            metadata={
                "engine": DISTRIBUTION_ENGINE,
                "formula_execution": False,
            },
        )

    # -------------------------------------------------------------------------
    # NORMALIZATION
    # -------------------------------------------------------------------------

    try:
        normalized_input = normalize_distribution_input(
            input_data
        )
    except Exception as exc:
        return DistributionEngineResult(
            status=DistributionStatus.INVALID,
            instrument_id=input_data.instrument_id,
            symbol=input_data.symbol,
            errors=[
                f"distribution input normalization failed: {exc}"
            ],
            metadata={
                "engine": DISTRIBUTION_ENGINE,
                "formula_execution": False,
            },
        )

    # -------------------------------------------------------------------------
    # INPUT VALIDATION
    # -------------------------------------------------------------------------

    validation = validate_distribution_input(
        normalized_input
    )

    warnings.extend(validation.get("warnings", []))
    errors.extend(validation.get("errors", []))

    if not validation.get("valid", False):
        return DistributionEngineResult(
            status=DistributionStatus.INVALID,
            instrument_id=normalized_input.instrument_id,
            symbol=normalized_input.symbol,
            warnings=warnings,
            errors=errors,
            metadata={
                "engine": DISTRIBUTION_ENGINE,
                "input_validation": validation,
                "formula_execution": False,
            },
        )

    if not validation.get("ready", False):
        return DistributionEngineResult(
            status=DistributionStatus.INSUFFICIENT_DATA,
            instrument_id=normalized_input.instrument_id,
            symbol=normalized_input.symbol,
            warnings=warnings,
            errors=errors,
            metadata={
                "engine": DISTRIBUTION_ENGINE,
                "input_validation": validation,
                "formula_execution": False,
            },
        )

    # -------------------------------------------------------------------------
    # EXPLICIT FORMULA REQUIREMENT
    # -------------------------------------------------------------------------

    if not formula_id:
        return DistributionEngineResult(
            status=DistributionStatus.DEGRADED,
            instrument_id=normalized_input.instrument_id,
            symbol=normalized_input.symbol,
            warnings=warnings + [
                "No distribution research formula selected"
            ],
            errors=errors,
            metadata={
                "engine": DISTRIBUTION_ENGINE,
                "formula_execution": False,
                "research_formula_required": True,
                "intelligence_generated": False,
                "reason": "NO_FORMULA_SELECTED",
            },
        )

    # -------------------------------------------------------------------------
    # FORMULA RESOLUTION
    # -------------------------------------------------------------------------

    provider = resolve_distribution_formula(
        formula_id=formula_id,
        formula_version=formula_version,
        registry=registry,
    )

    if provider is None:
        return DistributionEngineResult(
            status=DistributionStatus.DEGRADED,
            instrument_id=normalized_input.instrument_id,
            symbol=normalized_input.symbol,
            formula_id=formula_id,
            formula_version=formula_version,
            warnings=warnings + [
                "Requested distribution formula was not found"
            ],
            errors=errors,
            metadata={
                "engine": DISTRIBUTION_ENGINE,
                "formula_execution": False,
                "research_formula_required": True,
                "reason": "FORMULA_NOT_FOUND",
            },
        )

    # -------------------------------------------------------------------------
    # FORMULA DESCRIPTOR
    # -------------------------------------------------------------------------

    try:
        descriptor = provider.describe()
    except Exception as exc:
        return DistributionEngineResult(
            status=DistributionStatus.INVALID,
            instrument_id=normalized_input.instrument_id,
            symbol=normalized_input.symbol,
            formula_id=formula_id,
            formula_version=formula_version,
            errors=[
                f"distribution formula descriptor failed: {exc}"
            ],
            metadata={
                "engine": DISTRIBUTION_ENGINE,
                "formula_execution": False,
                "reason": "FORMULA_DESCRIPTOR_ERROR",
            },
        )

    if not isinstance(
        descriptor,
        DistributionFormulaDescriptor,
    ):
        return DistributionEngineResult(
            status=DistributionStatus.INVALID,
            instrument_id=normalized_input.instrument_id,
            symbol=normalized_input.symbol,
            formula_id=formula_id,
            formula_version=formula_version,
            errors=[
                "Distribution formula descriptor has invalid type"
            ],
            metadata={
                "engine": DISTRIBUTION_ENGINE,
                "formula_execution": False,
                "reason": "INVALID_FORMULA_DESCRIPTOR",
            },
        )

    # -------------------------------------------------------------------------
    # ENABLEMENT
    # -------------------------------------------------------------------------

    if not descriptor.enabled:
        return DistributionEngineResult(
            status=DistributionStatus.DEGRADED,
            instrument_id=normalized_input.instrument_id,
            symbol=normalized_input.symbol,
            formula_id=descriptor.formula_id,
            formula_version=descriptor.formula_version,
            warnings=warnings + [
                "Distribution research formula is disabled"
            ],
            errors=errors,
            metadata={
                "engine": DISTRIBUTION_ENGINE,
                "formula_execution": False,
                "research_validated": bool(descriptor.validated),
                "reason": "FORMULA_DISABLED",
            },
        )

    # -------------------------------------------------------------------------
    # RESEARCH VALIDATION GATE
    # -------------------------------------------------------------------------

    if not descriptor.validated:
        return DistributionEngineResult(
            status=DistributionStatus.DEGRADED,
            instrument_id=normalized_input.instrument_id,
            symbol=normalized_input.symbol,
            formula_id=descriptor.formula_id,
            formula_version=descriptor.formula_version,
            warnings=warnings + [
                "Distribution formula is not research validated"
            ],
            errors=errors,
            metadata={
                "engine": DISTRIBUTION_ENGINE,
                "formula_execution": False,
                "research_validated": False,
                "reason": "FORMULA_NOT_RESEARCH_VALIDATED",
            },
        )

    # -------------------------------------------------------------------------
    # VERSION TRACEABILITY
    # -------------------------------------------------------------------------

    if (
        formula_version is not None
        and str(formula_version)
        != str(descriptor.formula_version)
    ):
        return DistributionEngineResult(
            status=DistributionStatus.DEGRADED,
            instrument_id=normalized_input.instrument_id,
            symbol=normalized_input.symbol,
            formula_id=descriptor.formula_id,
            formula_version=descriptor.formula_version,
            warnings=warnings + [
                "Requested distribution formula version does not match "
                "registered provider version"
            ],
            errors=errors,
            metadata={
                "engine": DISTRIBUTION_ENGINE,
                "formula_execution": False,
                "research_validated": bool(descriptor.validated),
                "requested_formula_version": formula_version,
                "registered_formula_version": (
                    descriptor.formula_version
                ),
                "reason": "FORMULA_VERSION_MISMATCH",
            },
        )

    # -------------------------------------------------------------------------
    # FORMULA EXECUTION
    # -------------------------------------------------------------------------

    try:
        analysis = provider.analyze(
            normalized_input
        )
    except Exception as exc:
        return DistributionEngineResult(
            status=DistributionStatus.INVALID,
            instrument_id=normalized_input.instrument_id,
            symbol=normalized_input.symbol,
            formula_id=descriptor.formula_id,
            formula_version=descriptor.formula_version,
            warnings=warnings,
            errors=[
                f"distribution formula execution failed: {exc}"
            ],
            metadata={
                "engine": DISTRIBUTION_ENGINE,
                "formula_execution": True,
                "research_validated": bool(descriptor.validated),
                "reason": "FORMULA_EXECUTION_ERROR",
            },
        )

    # -------------------------------------------------------------------------
    # RESULT TYPE VALIDATION
    # -------------------------------------------------------------------------

    if not isinstance(
        analysis,
        DistributionAnalysis,
    ):
        return DistributionEngineResult(
            status=DistributionStatus.INVALID,
            instrument_id=normalized_input.instrument_id,
            symbol=normalized_input.symbol,
            formula_id=descriptor.formula_id,
            formula_version=descriptor.formula_version,
            warnings=warnings,
            errors=[
                "Distribution formula returned invalid analysis type"
            ],
            metadata={
                "engine": DISTRIBUTION_ENGINE,
                "formula_execution": True,
                "reason": "INVALID_FORMULA_RESULT",
            },
        )

    # -------------------------------------------------------------------------
    # TRACEABILITY ENFORCEMENT
    # -------------------------------------------------------------------------

    formula_metadata = _distribution_formula_metadata(
        descriptor
    )

    analysis = replace(
        analysis,
        instrument_id=(
            analysis.instrument_id
            or normalized_input.instrument_id
        ),
        symbol=(
            analysis.symbol
            or normalized_input.symbol
        ),
        timeframe=(
            analysis.timeframe
            if analysis.timeframe != Timeframe.UNKNOWN
            else normalized_input.timeframe
        ),
        formula_id=descriptor.formula_id,
        formula_version=descriptor.formula_version,
        formula_name=descriptor.name,
        formula_owner=descriptor.owner,
        formula_registry_key=(
            f"{descriptor.formula_id}@{descriptor.formula_version}"
        ),
        research_validated=True,
        is_signal=False,
        is_decision=False,
        is_opportunity=False,
        metadata={
            **dict(analysis.metadata),
            **formula_metadata,
            "distribution_engine": DISTRIBUTION_ENGINE,
            "distribution_engine_version": (
                DISTRIBUTION_ENGINE_VERSION
            ),
        },
    )

    # -------------------------------------------------------------------------
    # ANALYSIS STATUS
    # -------------------------------------------------------------------------

    final_status = (
        DistributionStatus.READY
        if analysis.status
        not in (
            DistributionStatus.INVALID,
            DistributionStatus.INSUFFICIENT_DATA,
        )
        else analysis.status
    )

    return DistributionEngineResult(
        status=final_status,
        analysis=analysis,
        instrument_id=normalized_input.instrument_id,
        symbol=normalized_input.symbol,
        research_validated=True,
        formula_id=descriptor.formula_id,
        formula_version=descriptor.formula_version,
        warnings=warnings + list(analysis.warnings),
        errors=errors + list(analysis.errors),
        metadata={
            "engine": DISTRIBUTION_ENGINE,
            "engine_version": DISTRIBUTION_ENGINE_VERSION,
            "formula_execution": True,
            "research_validated": True,
            "intelligence_generated_by": "UPSTREAM_RESEARCH_FORMULA",
            "engine_generated_formula": False,
            "upstream_truth_preserved": True,
        },
    )


# =============================================================================
# MULTI-TIMEFRAME RELATION
# =============================================================================

def classify_distribution_relation(
    analyses: Mapping[Timeframe, DistributionAnalysis],
) -> DistributionRelation:
    """
    Determine semantic relationship between timeframe analyses.

    This is aggregation/orchestration only.

    It does NOT replace the research formula governing each timeframe.
    """

    valid_analyses = [
        analysis
        for analysis in analyses.values()
        if isinstance(
            analysis,
            DistributionAnalysis,
        )
        and analysis.research_validated
    ]

    if not valid_analyses:
        return DistributionRelation.UNKNOWN

    states = {
        analysis.state
        for analysis in valid_analyses
        if analysis.state != DistributionState.UNKNOWN
    }

    directions = {
        analysis.direction
        for analysis in valid_analyses
        if analysis.direction != DistributionDirection.UNKNOWN
    }

    # Explicit invalidation versus confirmed distribution is a direct
    # semantic conflict.
    if (
        DistributionState.CONFIRMED in states
        and DistributionState.INVALIDATED in states
    ):
        return DistributionRelation.CONFLICTING

    # Bearish and bullish distribution direction simultaneously present.
    if (
        DistributionDirection.BEARISH in directions
        and DistributionDirection.BULLISH in directions
    ):
        return DistributionRelation.CONFLICTING

    # If all meaningful states agree, the timeframes are aligned.
    if len(states) == 1 and len(directions) <= 1:
        return DistributionRelation.ALIGNED

    # If one meaningful state exists but directions vary neutrally,
    # retain a neutral semantic relationship.
    if len(states) <= 1 and len(directions) <= 1:
        return DistributionRelation.NEUTRAL

    # Different timeframe states without a direct contradiction.
    return DistributionRelation.DIVERGENT


# =============================================================================
# DOMINANT DISTRIBUTION STATE
# =============================================================================

def determine_dominant_distribution_state(
    analyses: Mapping[Timeframe, DistributionAnalysis],
) -> DistributionState:
    """
    Determine dominant state using explicit semantic precedence.

    This is NOT a distribution formula and does not calculate distribution.
    """

    priority = {
        DistributionState.CONFIRMED: 6,
        DistributionState.DEVELOPING: 5,
        DistributionState.POSSIBLE: 4,
        DistributionState.ABSENT: 3,
        DistributionState.INVALIDATED: 2,
        DistributionState.UNKNOWN: 1,
    }

    candidates = [
        analysis.state
        for analysis in analyses.values()
        if isinstance(
            analysis,
            DistributionAnalysis,
        )
        and analysis.research_validated
    ]

    if not candidates:
        return DistributionState.UNKNOWN

    return max(
        candidates,
        key=lambda state: priority.get(
            state,
            0,
        ),
    )


# =============================================================================
# DOMINANT DISTRIBUTION DIRECTION
# =============================================================================

def determine_dominant_distribution_direction(
    analyses: Mapping[Timeframe, DistributionAnalysis],
) -> DistributionDirection:
    """
    Determine semantic dominant direction across validated analyses.
    """

    counts = {
        DistributionDirection.BEARISH: 0,
        DistributionDirection.BULLISH: 0,
        DistributionDirection.NEUTRAL: 0,
        DistributionDirection.MIXED: 0,
    }

    for analysis in analyses.values():

        if not isinstance(
            analysis,
            DistributionAnalysis,
        ):
            continue

        if not analysis.research_validated:
            continue

        direction = analysis.direction

        if direction in counts:
            counts[direction] += 1

    total = sum(counts.values())

    if total == 0:
        return DistributionDirection.UNKNOWN

    maximum = max(counts.values())

    winners = [
        direction
        for direction, count in counts.items()
        if count == maximum
    ]

    if (
        DistributionDirection.BEARISH in winners
        and DistributionDirection.BULLISH in winners
    ):
        return DistributionDirection.MIXED

    if len(winners) > 1:
        return DistributionDirection.NEUTRAL

    return winners[0]


# =============================================================================
# CONFIDENCE AGGREGATION
# =============================================================================

def _distribution_confidence_rank(
    confidence: DistributionConfidence,
) -> int:
    return {
        DistributionConfidence.VERY_LOW: 1,
        DistributionConfidence.LOW: 2,
        DistributionConfidence.MODERATE: 3,
        DistributionConfidence.HIGH: 4,
        DistributionConfidence.VERY_HIGH: 5,
    }.get(
        confidence,
        0,
    )


def _distribution_confidence_from_rank(
    rank: float,
) -> DistributionConfidence:

    if rank >= 4.5:
        return DistributionConfidence.VERY_HIGH

    if rank >= 3.5:
        return DistributionConfidence.HIGH

    if rank >= 2.5:
        return DistributionConfidence.MODERATE

    if rank >= 1.5:
        return DistributionConfidence.LOW

    if rank > 0:
        return DistributionConfidence.VERY_LOW

    return DistributionConfidence.UNKNOWN


def _average_distribution_confidence(
    analyses: Mapping[Timeframe, DistributionAnalysis],
) -> DistributionConfidence:
    """
    Descriptive confidence aggregation.

    No new confidence formula is invented here.
    """

    ranks = [
        _distribution_confidence_rank(
            analysis.confidence
        )
        for analysis in analyses.values()
        if isinstance(
            analysis,
            DistributionAnalysis,
        )
        and analysis.research_validated
        and analysis.confidence
        != DistributionConfidence.UNKNOWN
    ]

    if not ranks:
        return DistributionConfidence.UNKNOWN

    return _distribution_confidence_from_rank(
        sum(ranks) / len(ranks)
    )


# =============================================================================
# MULTI-TIMEFRAME DISTRIBUTION ANALYSIS
# =============================================================================

def analyze_multitimeframe_distribution(
    input_data: MultiTimeframeDistributionInput,
    *,
    formula_map: Optional[Mapping[Timeframe, str]] = None,
    formula_version_map: Optional[Mapping[Timeframe, str]] = None,
    registry: Optional[DistributionFormulaRegistry] = None,
) -> DistributionEngineResult:
    """
    Execute distribution intelligence independently for each timeframe and
    aggregate the resulting validated analyses.
    """

    if not isinstance(
        input_data,
        MultiTimeframeDistributionInput,
    ):
        return DistributionEngineResult(
            status=DistributionStatus.INVALID,
            errors=[
                "multi_timeframe_input must be "
                "MultiTimeframeDistributionInput"
            ],
            metadata={
                "engine": DISTRIBUTION_ENGINE,
                "mtf_execution": False,
            },
        )

    normalized_input = (
        normalize_multitimeframe_distribution_input(
            input_data
        )
    )

    active_formula_map = dict(
        formula_map or {}
    )

    active_version_map = dict(
        formula_version_map or {}
    )

    analyses: Dict[
        Timeframe,
        DistributionAnalysis,
    ] = {}

    warnings: List[str] = []
    errors: List[str] = []

    # -------------------------------------------------------------------------
    # TIMEFRAME EXECUTION
    # -------------------------------------------------------------------------

    for timeframe, timeframe_input in normalized_input.inputs.items():

        selected_formula_id = active_formula_map.get(
            timeframe
        )

        selected_formula_version = active_version_map.get(
            timeframe
        )

        result = analyze_distribution(
            timeframe_input,
            formula_id=selected_formula_id,
            formula_version=selected_formula_version,
            registry=registry,
        )

        warnings.extend(result.warnings)
        errors.extend(result.errors)

        if result.analysis is not None:
            analyses[timeframe] = result.analysis

    # -------------------------------------------------------------------------
    # NO ANALYSES
    # -------------------------------------------------------------------------

    if not analyses:
        return DistributionEngineResult(
            status=DistributionStatus.DEGRADED,
            instrument_id=normalized_input.instrument_id,
            symbol=normalized_input.symbol,
            warnings=warnings + [
                "No validated timeframe distribution analyses available"
            ],
            errors=errors,
            metadata={
                "engine": DISTRIBUTION_ENGINE,
                "mtf_execution": True,
                "intelligence_generated": False,
            },
        )

    # -------------------------------------------------------------------------
    # RESEARCH VALIDATION
    # -------------------------------------------------------------------------

    all_validated = all(
        analysis.research_validated
        for analysis in analyses.values()
    )

    # -------------------------------------------------------------------------
    # SEMANTIC AGGREGATION
    # -------------------------------------------------------------------------

    relation = classify_distribution_relation(
        analyses
    )

    dominant_state = determine_dominant_distribution_state(
        analyses
    )

    dominant_direction = determine_dominant_distribution_direction(
        analyses
    )

    average_confidence = _average_distribution_confidence(
        analyses
    )

    mtf_status = (
        DistributionStatus.READY
        if all_validated
        else DistributionStatus.DEGRADED
    )

    multi_timeframe = MultiTimeframeDistribution(
        status=mtf_status,
        instrument_id=normalized_input.instrument_id,
        symbol=normalized_input.symbol,
        analyses=analyses,
        relation=relation,
        dominant_state=dominant_state,
        dominant_direction=dominant_direction,
        average_confidence=average_confidence,
        research_validated=all_validated,
        warnings=warnings,
        errors=errors,
        metadata={
            "engine": DISTRIBUTION_ENGINE,
            "engine_version": DISTRIBUTION_ENGINE_VERSION,
            "mtf_execution": True,
            "semantic_aggregation": True,
            "research_formula_generated_here": False,
            "upstream_truth_preserved": True,
        },
    )

    return DistributionEngineResult(
        status=mtf_status,
        analysis=None,
        multi_timeframe=multi_timeframe,
        instrument_id=normalized_input.instrument_id,
        symbol=normalized_input.symbol,
        research_validated=all_validated,
        warnings=warnings,
        errors=errors,
        metadata={
            "engine": DISTRIBUTION_ENGINE,
            "engine_version": DISTRIBUTION_ENGINE_VERSION,
            "mtf_execution": True,
            "validated_timeframe_count": sum(
                1
                for analysis in analyses.values()
                if analysis.research_validated
            ),
            "timeframe_count": len(analyses),
            "research_formula_generated_here": False,
            "intelligence_source": (
                "UPSTREAM_RESEARCH_FORMULA"
            ),
        },
    )


