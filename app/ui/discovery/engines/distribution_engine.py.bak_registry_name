# ------------------------------------------------------------
# CONTRACT / MODULE INTEGRITY
# ------------------------------------------------------------

def validate_distribution_contract_integrity(
    registry: Optional[DistributionFormulaRegistry] = None,
) -> Dict[str, Any]:
    registry = registry or get_default_distribution_formula_registry()

    errors = []
    warnings = []

    authority = validate_distribution_authority()

    if authority.get("valid") is not True:
        errors.append("distribution authority validation failed")

    required_contract_keys = {
        "layer",
        "role",
        "authority_owner",
        "inputs",
        "outputs",
        "formula_policy",
        "downstream_consumers",
        "forbidden_responsibilities",
    }

    missing_keys = required_contract_keys.difference(
        DISTRIBUTION_ENGINE_CONTRACT.keys()
    )

    if missing_keys:
        errors.append(
            "missing contract keys: "
            + ", ".join(sorted(missing_keys))
        )

    formula_policy = DISTRIBUTION_ENGINE_CONTRACT.get(
        "formula_policy",
        {},
    )

    if not formula_policy.get("registry_based", False):
        errors.append("formula registry policy is not enabled")

    if not formula_policy.get("validated_required", False):
        errors.append("validated research formula requirement missing")

    if formula_policy.get("default_formula_allowed", True):
        errors.append("default formula must remain forbidden")

    if formula_policy.get("guessing_allowed", True):
        errors.append("formula guessing must remain forbidden")

    if formula_policy.get("silent_substitution_allowed", True):
        errors.append(
            "silent formula substitution must remain forbidden"
        )

    registry_check = distribution_formula_readiness(registry)

    if not registry_check.get("registry_available", False):
        errors.append("formula registry unavailable")

    if errors:
        status = "INVALID"
    elif warnings:
        status = "DEGRADED"
    else:
        status = "VALID"

    return {
        "status": status,
        "valid": not errors,
        "errors": errors,
        "warnings": warnings,
        "authority_valid": authority,
        "formula_registry": registry_check,
    }


