def validate_distribution_measurement(
    measurement: DistributionMeasurement,
) -> Dict[str, Any]:
    """
    Validate atomic measurement traceability.
    """

    errors: List[str] = []
    warnings: List[str] = []

    if not isinstance(
        measurement,
        DistributionMeasurement,
    ):
        return {
            "valid": False,
            "errors": [
                "measurement must be DistributionMeasurement"
            ],
            "warnings": [],
        }

    if not measurement.name.strip():
        errors.append(
            "measurement name is required"
        )

    if measurement.research_validated:
        if not measurement.formula_id:
            errors.append(
                "validated measurement requires formula_id"
            )

        if not measurement.formula_version:
            errors.append(
                "validated measurement requires formula_version"
            )

    if measurement.value is None:
        warnings.append(
            f"measurement '{measurement.name}' has no value"
        )

    return {
        "valid": not errors,
        "errors": errors,
        "warnings": warnings,
    }


# =============================================================================
# WINDOW VALIDATION
# =============================================================================

def validate_distribution_window(
    window: DistributionWindow,
) -> Dict[str, Any]:
    """
    Validate descriptive observation window.
    """

    errors: List[str] = []
    warnings: List[str] = []

    if not isinstance(
        window,
        DistributionWindow,
    ):
        return {
            "valid": False,
            "errors": [
                "window must be DistributionWindow"
            ],
            "warnings": [],
        }

    if window.observation_count < 0:
        errors.append(
            "observation_count cannot be negative"
        )

    if (
        window.highest_price is not None
        and window.lowest_price is not None
        and window.highest_price < window.lowest_price
    ):
        errors.append(
            "highest_price cannot be below lowest_price"
        )

    if (
        window.total_volume is not None
        and window.total_volume < 0
    ):
        errors.append(
            "total_volume cannot be negative"
        )

    if (
        window.average_volume is not None
        and window.average_volume < 0
    ):
        errors.append(
            "average_volume cannot be negative"
        )

    if window.observation_count == 0:
        warnings.append(
            "distribution window contains zero observations"
        )

    return {
        "valid": not errors,
        "errors": errors,
        "warnings": warnings,
    }


# =============================================================================
# ANALYSIS VALIDATION
# =============================================================================

def validate_distribution_analysis(
    analysis: DistributionAnalysis,
) -> Dict[str, Any]:
    """
    Validate canonical DistributionAnalysis.

    Research validation is mandatory for usable intelligence.
    """

    errors: List[str] = []
    warnings: List[str] = []

    if not isinstance(
        analysis,
        DistributionAnalysis,
    ):
        return {
            "valid": False,
            "research_validated": False,
            "errors": [
                "analysis must be DistributionAnalysis"
            ],
            "warnings": [],
        }

    # -------------------------------------------------------------------------
    # RESEARCH TRACEABILITY
    # -------------------------------------------------------------------------

    if analysis.research_validated:

        if not analysis.formula_id:
            errors.append(
                "research_validated analysis requires formula_id"
            )

        if not analysis.formula_version:
            errors.append(
                "research_validated analysis requires formula_version"
            )

        if not analysis.formula_owner:
            errors.append(
                "research_validated analysis requires formula_owner"
            )

        if not analysis.formula_registry_key:
            errors.append(
                "research_validated analysis requires formula_registry_key"
            )

    else:
        warnings.append(
            "analysis is not research validated"
        )

    # -------------------------------------------------------------------------
    # INTELLIGENCE BOUNDARY
    # -------------------------------------------------------------------------

    if analysis.is_signal:
        errors.append(
            "DistributionAnalysis cannot be marked as signal"
        )

    if analysis.is_decision:
        errors.append(
            "DistributionAnalysis cannot be marked as decision"
        )

    if analysis.is_opportunity:
        errors.append(
            "DistributionAnalysis cannot be marked as opportunity"
        )

    # -------------------------------------------------------------------------
    # ENUM VALIDATION
    # -------------------------------------------------------------------------

    if not isinstance(
        analysis.status,
        DistributionStatus,
    ):
        errors.append(
            "invalid distribution status"
        )

    if not isinstance(
        analysis.state,
        DistributionState,
    ):
        errors.append(
            "invalid distribution state"
        )

    if not isinstance(
        analysis.direction,
        DistributionDirection,
    ):
        errors.append(
            "invalid distribution direction"
        )

    if not isinstance(
        analysis.phase,
        DistributionPhase,
    ):
        errors.append(
            "invalid distribution phase"
        )

    if not isinstance(
        analysis.strength,
        DistributionStrength,
    ):
        errors.append(
            "invalid distribution strength"
        )

    if not isinstance(
        analysis.confidence,
        DistributionConfidence,
    ):
        errors.append(
            "invalid distribution confidence"
        )

    if not isinstance(
        analysis.timeframe,
        Timeframe,
    ):
        errors.append(
            "invalid timeframe"
        )

    # -------------------------------------------------------------------------
    # MEASUREMENTS
    # -------------------------------------------------------------------------

    for index, measurement in enumerate(
        analysis.measurements
    ):
        validation = validate_distribution_measurement(
            measurement
        )

        if not validation["valid"]:
            errors.extend(
                [
                    f"measurement[{index}]: {error}"
                    for error in validation["errors"]
                ]
            )

        warnings.extend(
            [
                f"measurement[{index}]: {warning}"
                for warning in validation["warnings"]
            ]
        )

    # -------------------------------------------------------------------------
    # WINDOW
    # -------------------------------------------------------------------------

    if analysis.window is not None:

        window_validation = validate_distribution_window(
            analysis.window
        )

        if not window_validation["valid"]:
            errors.extend(
                [
                    f"window: {error}"
                    for error in window_validation["errors"]
                ]
            )

        warnings.extend(
            [
                f"window: {warning}"
                for warning in window_validation["warnings"]
            ]
        )

    return {
        "valid": not errors,
        "research_validated": bool(
            analysis.research_validated
        ),
        "errors": errors,
        "warnings": warnings,
    }


# =============================================================================
# MULTI-TIMEFRAME VALIDATION
# =============================================================================

def validate_multitimeframe_distribution(
    multi_timeframe: MultiTimeframeDistribution,
) -> Dict[str, Any]:
    """
    Validate multi-timeframe distribution intelligence.
    """

    errors: List[str] = []
    warnings: List[str] = []

    if not isinstance(
        multi_timeframe,
        MultiTimeframeDistribution,
    ):
        return {
            "valid": False,
            "research_validated": False,
            "errors": [
                "multi_timeframe must be "
                "MultiTimeframeDistribution"
            ],
            "warnings": [],
        }

    if not isinstance(
        multi_timeframe.relation,
        DistributionRelation,
    ):
        errors.append(
            "invalid multi-timeframe relation"
        )

    if not isinstance(
        multi_timeframe.dominant_state,
        DistributionState,
    ):
        errors.append(
            "invalid dominant distribution state"
        )

    if not isinstance(
        multi_timeframe.dominant_direction,
        DistributionDirection,
    ):
        errors.append(
            "invalid dominant distribution direction"
        )

    if not isinstance(
        multi_timeframe.average_confidence,
        DistributionConfidence,
    ):
        errors.append(
            "invalid average distribution confidence"
        )

    if not multi_timeframe.analyses:
        warnings.append(
            "multi-timeframe distribution contains no analyses"
        )

    validated_count = 0

    for timeframe, analysis in (
        multi_timeframe.analyses.items()
    ):

        if not isinstance(
            timeframe,
            Timeframe,
        ):
            errors.append(
                f"invalid timeframe key: {timeframe!r}"
            )

        validation = validate_distribution_analysis(
            analysis
        )

        if not validation["valid"]:
            errors.extend(
                [
                    f"{timeframe}: {error}"
                    for error in validation["errors"]
                ]
            )

        warnings.extend(
            [
                f"{timeframe}: {warning}"
                for warning in validation["warnings"]
            ]
        )

        if analysis.research_validated:
            validated_count += 1

    if multi_timeframe.research_validated:

        if validated_count != len(
            multi_timeframe.analyses
        ):
            errors.append(
                "multi-timeframe result marked research_validated "
                "but not all analyses are validated"
            )

    return {
        "valid": not errors,
        "research_validated": bool(
            multi_timeframe.research_validated
        ),
        "validated_analysis_count": validated_count,
        "analysis_count": len(
            multi_timeframe.analyses
        ),
        "errors": errors,
        "warnings": warnings,
    }


