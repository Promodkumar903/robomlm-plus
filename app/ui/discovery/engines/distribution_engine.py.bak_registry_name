_DEFAULT_DISTRIBUTION_FORMULA_REGISTRY = (
    DistributionFormulaRegistry()
)


def get_distribution_formula_registry() -> DistributionFormulaRegistry:
    """
    Return the process-level Distribution Formula Registry.
    """

    return _DEFAULT_DISTRIBUTION_FORMULA_REGISTRY


def resolve_distribution_formula(
    formula_id: Optional[str],
    formula_version: Optional[str] = None,
    *,
    registry: Optional[DistributionFormulaRegistry] = None,
) -> Optional[DistributionFormulaProvider]:
    """
    Resolve an explicitly requested distribution formula.

    No implicit/default formula is selected.
    """

    if not formula_id:
        return None

    active_registry = (
        registry
        if registry is not None
        else get_distribution_formula_registry()
    )

    return active_registry.get(
        formula_id=str(formula_id),
        formula_version=(
            str(formula_version)
            if formula_version is not None
            else None
        ),
    )


# =============================================================================
# FORMULA READINESS
# =============================================================================

def distribution_formula_readiness(
    formula_id: Optional[str],
    formula_version: Optional[str] = None,
    *,
    registry: Optional[DistributionFormulaRegistry] = None,
) -> Dict[str, Any]:
    """
    Determine whether an explicit validated research formula is available.
    """

    if not formula_id:
        return {
            "ready": False,
            "formula_selected": False,
            "formula_found": False,
            "research_validated": False,
            "formula_id": None,
            "formula_version": None,
            "reason": "NO_FORMULA_SELECTED",
        }

    provider = resolve_distribution_formula(
        formula_id,
        formula_version,
        registry=registry,
    )

    if provider is None:
        return {
            "ready": False,
            "formula_selected": True,
            "formula_found": False,
            "research_validated": False,
            "formula_id": formula_id,
            "formula_version": formula_version,
            "reason": "FORMULA_NOT_FOUND",
        }

    descriptor = provider.describe()

    if not descriptor.enabled:
        return {
            "ready": False,
            "formula_selected": True,
            "formula_found": True,
            "research_validated": bool(descriptor.validated),
            "formula_id": descriptor.formula_id,
            "formula_version": descriptor.formula_version,
            "reason": "FORMULA_DISABLED",
        }

    if not descriptor.validated:
        return {
            "ready": False,
            "formula_selected": True,
            "formula_found": True,
            "research_validated": False,
            "formula_id": descriptor.formula_id,
            "formula_version": descriptor.formula_version,
            "reason": "FORMULA_NOT_RESEARCH_VALIDATED",
        }

    return {
        "ready": True,
        "formula_selected": True,
        "formula_found": True,
        "research_validated": True,
        "formula_id": descriptor.formula_id,
        "formula_version": descriptor.formula_version,
        "reason": "VALIDATED_FORMULA_AVAILABLE",
    }


