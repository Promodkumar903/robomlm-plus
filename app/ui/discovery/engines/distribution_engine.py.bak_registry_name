def create_default_distribution_engine_request(
    instrument_id: Optional[str] = None,
    symbol: Optional[str] = None,
    asset_class: Optional[str] = None,
    market_id: Optional[str] = None,
    timeframe: Timeframe = Timeframe.UNKNOWN,
) -> DistributionEngineRequest:
    """
    Create a structurally valid request shell.

    No market intelligence and no formula are fabricated.
    """

    input_data = DistributionInput(
        instrument_id=instrument_id,
        symbol=symbol,
        asset_class=asset_class,
        market_id=market_id,
        timeframe=timeframe,
        metadata={
            "request_shell": True,
            "intelligence_available": False,
            "formula_selected": False,
        },
    )

    return create_distribution_request(
        input_data=input_data,
        metadata={
            "default_request": True,
            "formula_required": True,
            "research_formula_required": True,
        },
    )


