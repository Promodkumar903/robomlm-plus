# INPUT VALIDATION
# =============================================================================

def validate_distribution_input(
    input_data: DistributionInput,
) -> Dict[str, Any]:
    """
    Validate structural integrity of normalized DistributionInput.

    Validation here is data-contract validation only.
    It does NOT validate whether distribution exists in the market.
    """

    errors: List[str] = []
    warnings: List[str] = []

    if not isinstance(input_data, DistributionInput):
        return {
            "valid": False,
            "ready": False,
            "errors": [
                "input_data must be DistributionInput"
            ],
            "warnings": [],
        }

    if not input_data.instrument_id and not input_data.symbol:
        errors.append(
            "instrument_id or symbol is required"
        )

    if not input_data.asset_class:
        errors.append("asset_class is required")

    if not input_data.market_id:
        errors.append("market_id is required")

    if input_data.timeframe == Timeframe.UNKNOWN:
        warnings.append(
            "timeframe is UNKNOWN"
        )

    series = {
        "opens": input_data.opens,
        "highs": input_data.highs,
        "lows": input_data.lows,
        "closes": input_data.closes,
    }

    lengths = {
        name: len(values)
        for name, values in series.items()
    }

    non_zero_lengths = {
        value
        for value in lengths.values()
        if value > 0
    }

    if not non_zero_lengths:
        errors.append(
            "At least one OHLC observation is required"
        )

    if len(non_zero_lengths) > 1:
        errors.append(
            "OHLC series lengths are inconsistent"
        )

    expected_length = (
        next(iter(non_zero_lengths))
        if len(non_zero_lengths) == 1
        else 0
    )

    if expected_length > 0:

        for name, values in series.items():
            if values and len(values) != expected_length:
                errors.append(
                    f"{name} length does not match OHLC observation count"
                )

        if input_data.volumes:
            if len(input_data.volumes) != expected_length:
                errors.append(
                    "volumes length does not match OHLC observation count"
                )
        else:
            warnings.append(
                "volume data is unavailable"
            )

        if input_data.timestamps:
            if len(input_data.timestamps) != expected_length:
                errors.append(
                    "timestamps length does not match OHLC observation count"
                )
        else:
            warnings.append(
                "timestamps are unavailable"
            )

    # Price relationship validation.
    if input_data.highs and input_data.lows:

        if len(input_data.highs) == len(input_data.lows):

            for index, (high, low) in enumerate(
                zip(input_data.highs, input_data.lows)
            ):
                if high < low:
                    errors.append(
                        f"high < low at observation index {index}"
                    )

                if high <= 0 or low <= 0:
                    errors.append(
                        f"non-positive high/low at observation index {index}"
                    )

    for name, values in series.items():

        for index, value in enumerate(values):

            if value <= 0:
                errors.append(
                    f"{name}[{index}] must be positive"
                )

    for index, volume in enumerate(input_data.volumes):

        if volume < 0:
            errors.append(
                f"volume[{index}] cannot be negative"
            )

    return {
        "valid": not errors,
        "ready": not errors and expected_length > 0,
        "observation_count": expected_length,
        "volume_available": bool(input_data.volumes),
        "timestamps_available": bool(input_data.timestamps),
        "structure_context_available": (
            input_data.structure_context is not None
        ),
        "errors": errors,
        "warnings": warnings,
    }


def distribution_input_readiness(
    input_data: DistributionInput,
) -> Dict[str, Any]:
    """
    Report whether the input is suitable for distribution-formula execution.

    This does not claim that distribution intelligence is available.
    """

    validation = validate_distribution_input(input_data)

    missing: List[str] = []

    if not input_data.instrument_id and not input_data.symbol:
        missing.append("instrument_id_or_symbol")

    if not input_data.asset_class:
        missing.append("asset_class")

    if not input_data.market_id:
        missing.append("market_id")

    if not input_data.opens:
        missing.append("opens")

    if not input_data.highs:
        missing.append("highs")

    if not input_data.lows:
        missing.append("lows")

    if not input_data.closes:
        missing.append("closes")

    if not input_data.volumes:
        missing.append("volumes")

    return {
        "ready": validation["ready"],
        "valid": validation["valid"],
        "missing": missing,
        "observation_count": validation["observation_count"],
        "volume_available": validation["volume_available"],
        "timestamps_available": validation["timestamps_available"],
        "structure_context_available": (
            validation["structure_context_available"]
        ),
        "errors": list(validation["errors"]),
        "warnings": list(validation["warnings"]),
    }


