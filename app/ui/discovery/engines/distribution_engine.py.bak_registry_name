# ------------------------------------------------------------

def validate_distribution_module_integrity(
    registry: Optional[DistributionFormulaRegistry] = None,
) -> Dict[str, Any]:
    registry = registry or get_default_distribution_formula_registry()

    contract_check = validate_distribution_contract_integrity(registry)
    operational = distribution_engine_operational_check(registry)
    diagnostics = distribution_engine_diagnostics(registry)
    self_check = distribution_part4_self_check(registry)

    errors = []
    warnings = []

    errors.extend(contract_check.get("errors", []))
    errors.extend(operational.get("errors", []))
    errors.extend(self_check.get("errors", []))

    warnings.extend(contract_check.get("warnings", []))
    warnings.extend(operational.get("warnings", []))
    warnings.extend(diagnostics.get("warnings", []))
    warnings.extend(self_check.get("warnings", []))

    return {
        "engine": DISTRIBUTION_ENGINE,
        "version": DISTRIBUTION_ENGINE_VERSION,
        "valid": len(errors) == 0,
        "status": "VALID" if not errors else "INVALID",
        "errors": list(dict.fromkeys(errors)),
        "warnings": list(dict.fromkeys(warnings)),
        "contract": contract_check,
        "operational": operational,
        "diagnostics": diagnostics,
        "self_check": self_check,
        "manifest": distribution_engine_contract_manifest(),
    }


def distribution_engine_module_check(
    registry: Optional[DistributionFormulaRegistry] = None,
) -> bool:
    return bool(
        validate_distribution_module_integrity(registry).get(
            "valid",
            False,
        )
    )


# ------------------------------------------------------------
# FINAL SELF-CHECK
# ------------------------------------------------------------

def distribution_engine_self_check(
    registry: Optional[DistributionFormulaRegistry] = None,
) -> Dict[str, Any]:
    """
    Final architectural self-check.

    Critical rule:
    the engine must NEVER fabricate distribution intelligence
    without a validated upstream research formula.
    """

    registry = registry or get_default_distribution_formula_registry()

    checks = {
        "authority_valid": validate_distribution_authority(),
        "contract_manifest_available": bool(
            distribution_engine_contract_manifest()
        ),
        "formula_registry_available": registry is not None,
        "no_formula_guessing": (
            DISTRIBUTION_ENGINE_CONTRACT
            .get("formula_policy", {})
            .get("guessing_allowed", True)
            is False
        ),
        "no_default_formula": (
            DISTRIBUTION_ENGINE_CONTRACT
            .get("formula_policy", {})
            .get("default_formula_allowed", True)
            is False
        ),
        "no_silent_substitution": (
            DISTRIBUTION_ENGINE_CONTRACT
            .get("formula_policy", {})
            .get("silent_substitution_allowed", True)
            is False
        ),
        "engine_does_not_generate_formula": (
            DISTRIBUTION_ENGINE_CONTRACT
            .get("formula_policy", {})
            .get("engine_generates_formula", True)
            is False
        ),
        "distribution_not_signal": (
            DISTRIBUTION_ENGINE_AUTHORITY
            .get("confirmation_generation", True)
            is False
            and DISTRIBUTION_ENGINE_AUTHORITY
            .get("opportunity_generation", True)
            is False
        ),
        "distribution_not_decision": (
            DISTRIBUTION_ENGINE_AUTHORITY
            .get("decision_generation", True) is False
            and DISTRIBUTION_ENGINE_AUTHORITY
            .get("d13_generation", True) is False
        ),
        "distribution_not_risk": (
            DISTRIBUTION_ENGINE_AUTHORITY
            .get("risk_generation", True) is False
        ),
        "distribution_not_execution": (
            DISTRIBUTION_ENGINE_AUTHORITY
            .get("execution_generation", True) is False
        ),
    }

    errors = [
        key for key, passed in checks.items()
        if not passed
    ]

    return {
        "engine": DISTRIBUTION_ENGINE,
        "version": DISTRIBUTION_ENGINE_VERSION,
        "valid": not errors,
        "status": "PASS" if not errors else "FAIL",
        "checks": checks,
        "errors": errors,
        "warnings": [],
        "validated_formula_count": sum(
            1
            for descriptor in registry.descriptors()
            if descriptor.validated and descriptor.enabled
        ),
        "critical_truth": (
            "No validated research formula = no fabricated "
            "distribution intelligence."
        ),
    }


