# ============================================================
# CONTRACT VALIDATION
# ============================================================

@dataclass(frozen=True)
class ProtectionContractValidation:
    status: ProtectionContractStatus
    errors: tuple[str, ...] = ()

    @property
    def is_valid(self) -> bool:
        return self.status == ProtectionContractStatus.VALID


# ============================================================
# SAFE READ HELPERS
# ============================================================

def _pr_read_value(
    source: Any,
    *names: str,
    default: Any = None,
) -> Any:
    if source is None:
        return default

    if isinstance(source, Mapping):
        for name in names:
            if name in source:
                return source[name]

    for name in names:
        try:
            value = getattr(source, name)
        except (AttributeError, TypeError):
            continue

        if value is not None:
            return value

    return default


def _pr_text(value: Any) -> Optional[str]:
    if value is None:
        return None

    if isinstance(value, Enum):
        return value.value

    text = str(value).strip()
    return text if text else None


def _pr_float(value: Any) -> Optional[float]:
    if value is None:
        return None

    try:
        return float(value)
    except (TypeError, ValueError):
        return None


def _pr_bool(value: Any) -> bool:
    return bool(value)


# ============================================================
# POSITION ADAPTER
# ============================================================

def build_protection_position_reference(
    position: Any,
) -> ProtectionPositionReference:

    return ProtectionPositionReference(
        position_id=_pr_text(
            _pr_read_value(position, "position_id", "id")
        ),
        instrument=_pr_text(
            _pr_read_value(position, "instrument", "symbol")
        ),
        side=_pr_text(
            _pr_read_value(position, "side", "direction")
        ),
        position_state=_pr_text(
            _pr_read_value(
                position,
                "position_state",
                "state",
            )
        ),
        quantity=_pr_float(
            _pr_read_value(
                position,
                "quantity",
                "size",
                "position_size",
            )
        ),
        entry_price=_pr_float(
            _pr_read_value(
                position,
                "entry_price",
                "avg_entry_price",
            )
        ),
        current_price=_pr_float(
            _pr_read_value(
                position,
                "current_price",
                "mark_price",
                "last_price",
            )
        ),
        stop_loss=_pr_float(
            _pr_read_value(
                position,
                "stop_loss",
                "sl",
            )
        ),
        take_profit=_pr_float(
            _pr_read_value(
                position,
                "take_profit",
                "tp",
            )
        ),
        unrealized_pnl=_pr_float(
            _pr_read_value(
                position,
                "unrealized_pnl",
                "unrealized_profit",
            )
        ),
    )


# ============================================================
# MONITOR ADAPTER
# ============================================================

def build_protection_monitor_reference(
    monitor: Any,
) -> ProtectionMonitorReference:

    result = _pr_read_value(
        monitor,
        "result",
        "monitor_result",
    )

    return ProtectionMonitorReference(
        monitor_id=_pr_text(
            _pr_read_value(
                monitor,
                "monitor_id",
                "id",
            )
        ),
        status=_pr_text(
            _pr_read_value(
                result,
                "status",
            )
        ),
        health=_pr_text(
            _pr_read_value(
                result,
                "health",
            )
        ),
        consistency=_pr_text(
            _pr_read_value(
                result,
                "consistency",
            )
        ),
        disposition=_pr_text(
            _pr_read_value(
                result,
                "disposition",
            )
        ),
        action_state=_pr_text(
            _pr_read_value(
                result,
                "action_state",
            )
        ),
        requires_protection=_pr_bool(
            _pr_read_value(
                result,
                "requires_protection",
                default=False,
            )
        ),
        requires_halt=_pr_bool(
            _pr_read_value(
                result,
                "requires_halt",
                default=False,
            )
        ),
        raw_result=result if result is not None else monitor,
    )


