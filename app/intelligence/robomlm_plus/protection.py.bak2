# ============================================================
# ROBOMLM PLUS — PROTECTION ENGINE
# PART 1/5
# FOUNDATION + CONTRACTS + REFERENCES
# ============================================================

from __future__ import annotations

from dataclasses import dataclass, field
from datetime import datetime, timezone
from enum import Enum
from typing import Any, Mapping, Optional
from uuid import uuid4


# ============================================================
# MODULE CONSTANTS
# ============================================================

PROTECTION_ENGINE = "ROBOMLM_PLUS_PROTECTION"
PROTECTION_VERSION = "1.0"


# ============================================================
# ENUMS
# ============================================================

class ProtectionStatus(str, Enum):
    READY = "READY"
    PROTECTING = "PROTECTING"
    WARNING = "WARNING"
    CRITICAL = "CRITICAL"
    BLOCKED = "BLOCKED"
    INVALID = "INVALID"


class ProtectionState(str, Enum):
    AVAILABLE = "AVAILABLE"
    REQUIRED = "REQUIRED"
    ACTIVE = "ACTIVE"
    MISSING = "MISSING"
    UNKNOWN = "UNKNOWN"


class ProtectionHealth(str, Enum):
    HEALTHY = "HEALTHY"
    CAUTION = "CAUTION"
    AT_RISK = "AT_RISK"
    CRITICAL = "CRITICAL"
    UNKNOWN = "UNKNOWN"


class ProtectionDisposition(str, Enum):
    MAINTAIN = "MAINTAIN"
    PROTECT = "PROTECT"
    REVIEW = "REVIEW"
    BLOCK = "BLOCK"
    UNKNOWN = "UNKNOWN"


class ProtectionContractStatus(str, Enum):
    VALID = "VALID"
    INVALID = "INVALID"


# ============================================================
# REQUEST CONTRACT
# ============================================================

@dataclass(frozen=True)
class ProtectionRequest:
    """
    Controlled protection-layer request.

    Authority:
        D13      -> decision authority
        Risk     -> risk authority
        Position -> actual position state
        Monitor  -> monitoring/refinement signal
        Protection -> protection assessment

    This request does NOT authorize execution.
    """

    position_monitor: Any
    risk_state: Optional[Any] = None
    decision_state: Optional[Any] = None
    market_context: Optional[Any] = None
    account_state: Optional[Any] = None
    authorized_action: Optional[Any] = None
    metadata: Mapping[str, Any] = field(default_factory=dict)
    request_id: str = field(default_factory=lambda: str(uuid4()))
    timestamp: datetime = field(
        default_factory=lambda: datetime.now(timezone.utc)
    )

    def validate(self) -> tuple[str, ...]:
        errors = []

        if self.position_monitor is None:
            errors.append("position_monitor is required")

        if not self.request_id:
            errors.append("request_id is required")

        if not isinstance(self.metadata, Mapping):
            errors.append("metadata must be a Mapping")

        return tuple(errors)


