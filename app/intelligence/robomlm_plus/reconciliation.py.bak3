from __future__ import annotations

from dataclasses import dataclass, field
from datetime import datetime, timezone
from enum import Enum
from typing import Any, Mapping, Optional
from uuid import uuid4


# ============================================================
# ENGINE IDENTITY
# ============================================================

RECONCILIATION_ENGINE = "ROBOMLM_PLUS_RECONCILIATION"
RECONCILIATION_VERSION = "1.0"


# ============================================================
# CORE ENUMS
# ============================================================

class ReconciliationStatus(str, Enum):
    READY = "READY"
    RECONCILING = "RECONCILING"
    MATCHED = "MATCHED"
    WARNING = "WARNING"
    MISMATCH = "MISMATCH"
    CRITICAL = "CRITICAL"
    BLOCKED = "BLOCKED"
    INVALID = "INVALID"


class ReconciliationState(str, Enum):
    MATCHED = "MATCHED"
    PARTIAL_MATCH = "PARTIAL_MATCH"
    MISMATCH = "MISMATCH"
    UNKNOWN = "UNKNOWN"


class ReconciliationHealth(str, Enum):
    HEALTHY = "HEALTHY"
    CAUTION = "CAUTION"
    AT_RISK = "AT_RISK"
    CRITICAL = "CRITICAL"
    UNKNOWN = "UNKNOWN"


class ReconciliationDisposition(str, Enum):
    ACCEPT = "ACCEPT"
    REVIEW = "REVIEW"
    PROTECT = "PROTECT"
    BLOCK = "BLOCK"
    UNKNOWN = "UNKNOWN"


class ReconciliationContractStatus(str, Enum):
    VALID = "VALID"
    INVALID = "INVALID"


# ============================================================
# REQUEST CONTRACT
# ============================================================

@dataclass(frozen=True)
class ReconciliationRequest:
    """
    Input contract for the ROBOMLM_PLUS reconciliation layer.

    Reconciliation compares expected state against actual state.

    It MUST NOT:
    - create an order
    - execute an order
    - modify a position
    - create authorization
    - override D13
    - override Risk
    - invent missing state
    - calculate trading parameters
    """

    expected_state: Any
    actual_state: Any

    position_monitor: Any = None
    protection_state: Any = None
    risk_state: Any = None
    decision_state: Any = None
    account_state: Any = None
    execution_state: Any = None

    metadata: Mapping[str, Any] = field(default_factory=dict)

    request_id: str = field(
        default_factory=lambda: str(uuid4())
    )

    timestamp: datetime = field(
        default_factory=lambda: datetime.now(timezone.utc)
    )

    def validate(self) -> "ReconciliationContractValidation":
        errors = []

        if self.expected_state is None:
            errors.append("expected_state is required")

        if self.actual_state is None:
            errors.append("actual_state is required")

        if not self.request_id:
            errors.append("request_id is required")

        if not isinstance(self.metadata, Mapping):
            errors.append("metadata must be a Mapping")

        return ReconciliationContractValidation(
            status=(
                ReconciliationContractStatus.VALID
                if not errors
                else ReconciliationContractStatus.INVALID
            ),
            errors=tuple(errors),
        )


