def build_reconciliation_expected_reference(
    expected_state: Any,
) -> ReconciliationExpectedReference:
    """
    Build normalized expected-state reference.

    Values are read only when explicitly supplied.
    """

    return ReconciliationExpectedReference(
        state_id=_rr_text(
            expected_state,
            "state_id",
            "id",
            "position_id",
        ),
        instrument=_rr_text(
            expected_state,
            "instrument",
            "symbol",
            "ticker",
        ),
        side=_rr_text(
            expected_state,
            "side",
            "position_side",
        ),
        position_state=_rr_text(
            expected_state,
            "position_state",
            "state",
            "status",
        ),
        quantity=_rr_float(
            expected_state,
            "quantity",
            "qty",
            "size",
        ),
        entry_price=_rr_float(
            expected_state,
            "entry_price",
            "entry",
        ),
        current_price=_rr_float(
            expected_state,
            "current_price",
            "mark_price",
            "price",
        ),
        stop_loss=_rr_float(
            expected_state,
            "stop_loss",
            "sl",
        ),
        take_profit=_rr_float(
            expected_state,
            "take_profit",
            "tp",
            "target",
        ),
        leverage=_rr_float(
            expected_state,
            "leverage",
        ),
        margin=_rr_float(
            expected_state,
            "margin",
        ),
        raw_state=expected_state,
    )


