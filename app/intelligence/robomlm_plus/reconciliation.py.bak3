@dataclass(frozen=True)
class ReconciliationContractValidation:
    status: ReconciliationContractStatus
    errors: tuple[str, ...] = ()

    @property
    def is_valid(self) -> bool:
        return self.status == ReconciliationContractStatus.VALID


# ============================================================
# SAFE VALUE READER
# ============================================================

def _rr_read_value(
    source: Any,
    *names: str,
    default: Any = None,
) -> Any:
    """
    Read an explicitly supplied field from an object or mapping.

    No inference or calculation is performed.
    """
    if source is None:
        return default

    if isinstance(source, Mapping):
        for name in names:
            if name in source:
                return source[name]
        return default

    for name in names:
        try:
            value = getattr(source, name)
        except AttributeError:
            continue

        if value is not None:
            return value

    return default


def _rr_text(
    source: Any,
    *names: str,
    default: Optional[str] = None,
) -> Optional[str]:
    value = _rr_read_value(
        source,
        *names,
        default=default,
    )

    if value is None:
        return default

    return str(value)


def _rr_float(
    source: Any,
    *names: str,
    default: Optional[float] = None,
) -> Optional[float]:
    value = _rr_read_value(
        source,
        *names,
        default=default,
    )

    if value is None:
        return default

    try:
        return float(value)
    except (TypeError, ValueError):
        return default


