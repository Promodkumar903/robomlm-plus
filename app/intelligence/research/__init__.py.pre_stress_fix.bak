"""
ROBOMLM Research Intelligence Package
======================================

Research lifecycle layer for ROBOMLM.

Modules:
    candidate_manager
    dataset
    deployment_manager
    experiment
    hypothesis
    research_service
    stress_testing
    validation
    version_manager

Boundary:
    Research lifecycle only.

This package does NOT:
    - execute trades
    - create orders
    - modify positions
    - authorize accounts
    - override D13
    - override Risk
    - override CAS
    - activate production systems
"""

from __future__ import annotations


