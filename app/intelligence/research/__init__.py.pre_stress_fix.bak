# ============================================================
# PACKAGE HEALTH
# ============================================================

def research_package_health_check() -> dict[str, object]:
    """
    Aggregated health check for the complete research package.
    """

    checks = {
        "candidate_manager": run_candidate_manager_health_check(),
        "dataset": run_dataset_manager_health_check(),
        "deployment_manager": run_deployment_manager_health_check(),
        "experiment": experiment_health_check()["healthy"],
        "hypothesis": hypothesis_health_check()["healthy"],
        "research_service": run_research_service_integrity_check(),
        "stress_testing": run_stress_testing_health_check(),
        "validation": run_validation_health_check(),
        "version_manager": run_version_manager_health_check(),
    }

    return {
        "healthy": all(checks.values()),
        "package": RESEARCH_PACKAGE_NAME,
        "version": RESEARCH_PACKAGE_VERSION,
        "status": RESEARCH_PACKAGE_STATUS,
        "checks": checks,
        "execution_allowed": False,
        "trade_allowed": False,
        "order_allowed": False,
        "position_change_allowed": False,
        "authorization_allowed": False,
        "d13_override": False,
        "risk_override": False,
        "cas_override": False,
    }


def run_research_package_health_check() -> bool:
    return bool(research_package_health_check()["healthy"])


