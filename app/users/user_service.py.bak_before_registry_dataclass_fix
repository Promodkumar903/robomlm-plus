# ============================================================================
# NORMALIZATION
# ============================================================================

def normalize_user_request(request: UserRequest) -> UserRequest:
    """
    Normalize a user request without changing its domain meaning.
    """

    if not isinstance(request, UserRequest):
        raise TypeError("request must be UserRequest")

    request.request_id = _user_text(request.request_id)
    request.user_id = _user_text(request.user_id)
    request.email = _user_text(request.email).lower()
    request.display_name = _user_text(request.display_name)

    request.status = _user_enum(
        request.status,
        UserStatus,
        UserStatus.UNKNOWN,
    )

    request.mode = _user_enum(
        request.mode,
        UserMode,
        UserMode.UNKNOWN,
    )

    request.priority = _user_enum(
        request.priority,
        UserPriority,
        UserPriority.NORMAL,
    )

    if request.lifecycle_event is not None:
        request.lifecycle_event = _user_enum(
            request.lifecycle_event,
            UserLifecycleEvent,
            UserLifecycleEvent.CREATED,
        )

    request.locale = _user_text(request.locale)
    request.timezone = _user_text(request.timezone)
    request.country = _user_text(request.country).upper()

    if not isinstance(request.metadata, dict):
        request.metadata = {}

    request.created_at = _user_timestamp(request.created_at)

    return request


# ============================================================================
# REQUEST VALIDATION
# ============================================================================

def validate_user_request(
    request: UserRequest,
) -> UserContractValidation:
    """
    Validate the user-domain request contract.

    This validates structure and domain consistency only.
    """

    errors: List[str] = []
    warnings: List[str] = []

    if not isinstance(request, UserRequest):
        return UserContractValidation(
            status=UserContractStatus.INVALID,
            valid=False,
            errors=["request must be UserRequest"],
        )

    normalize_user_request(request)

    if not request.user_id:
        warnings.append("user_id is empty")

    if not request.email:
        warnings.append("email is empty")

    if request.email and "@" not in request.email:
        errors.append("email format is invalid")

    if request.status == UserStatus.UNKNOWN:
        warnings.append("user status is UNKNOWN")

    if request.mode == UserMode.UNKNOWN:
        warnings.append("user mode is UNKNOWN")

    if request.lifecycle_event is not None:
        valid_events = set(UserLifecycleEvent)

        if request.lifecycle_event not in valid_events:
            errors.append("invalid lifecycle event")

    valid = len(errors) == 0

    return UserContractValidation(
        status=(
            UserContractStatus.VALID
            if valid
            else UserContractStatus.INVALID
        ),
        valid=valid,
        errors=errors,
        warnings=warnings,
        metadata={
            "validation_only": True,
            "authentication": False,
            "billing": False,
            "subscription": False,
            "intelligence_generation": False,
            "decision_generation": False,
            "d13_mutation": False,
            "risk_generation": False,
            "cas_override": False,
            "execution": False,
        },
    )


