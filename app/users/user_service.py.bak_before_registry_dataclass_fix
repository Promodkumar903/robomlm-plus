# ============================================================================
# USER REQUIREMENT BUILDER
# ============================================================================

def build_user_requirements(
    require_user_id: bool = True,
    require_email: bool = True,
    require_display_name: bool = False,
    require_active_status: bool = False,
    require_mode: bool = False,
    require_locale: bool = False,
    require_timezone: bool = False,
    require_country: bool = False,
    minimum_completeness: float = 0.70,
    minimum_confidence: float = 0.70,
    minimum_quality: float = 0.70,
    metadata: Optional[Dict[str, Any]] = None,
) -> UserRequirements:
    """
    Build normalized user requirements.
    """

    return UserRequirements(
        require_user_id=bool(require_user_id),
        require_email=bool(require_email),
        require_display_name=bool(require_display_name),
        require_active_status=bool(require_active_status),
        require_mode=bool(require_mode),
        require_locale=bool(require_locale),
        require_timezone=bool(require_timezone),
        require_country=bool(require_country),
        minimum_completeness=max(
            0.0,
            min(1.0, float(minimum_completeness)),
        ),
        minimum_confidence=max(
            0.0,
            min(1.0, float(minimum_confidence)),
        ),
        minimum_quality=max(
            0.0,
            min(1.0, float(minimum_quality)),
        ),
        metadata=dict(metadata or {}),
    )


# ============================================================================
# USER REQUIREMENT EVALUATION
# ============================================================================

def evaluate_user_requirements(
    user: UserRecord,
    requirements: UserRequirements,
) -> tuple[bool, List[str]]:
    """
    Evaluate declared user-domain requirements.

    Returns:
        (requirements_met, flags)
    """

    if not isinstance(user, UserRecord):
        return False, ["invalid_user_record"]

    if not isinstance(requirements, UserRequirements):
        return False, ["invalid_user_requirements"]

    flags: List[str] = []

    if requirements.require_user_id and not user.user_id:
        flags.append("missing_user_id")

    if requirements.require_email and not user.email:
        flags.append("missing_email")

    if requirements.require_display_name and not user.display_name:
        flags.append("missing_display_name")

    if requirements.require_active_status:
        if user.status != UserStatus.ACTIVE:
            flags.append("user_not_active")

    if requirements.require_mode:
        if user.mode == UserMode.UNKNOWN:
            flags.append("missing_mode")

    if requirements.require_locale and not user.locale:
        flags.append("missing_locale")

    if requirements.require_timezone and not user.timezone:
        flags.append("missing_timezone")

    if requirements.require_country and not user.country:
        flags.append("missing_country")

    return len(flags) == 0, flags


# ============================================================================
# USER COMPLETENESS
# ============================================================================

def calculate_user_completeness(
    user: UserRecord,
    requirements: UserRequirements,
) -> float:
    """
    Calculate completeness against the declared user requirements.

    Each declared requirement contributes equally.

    This is a data-quality measure only.
    """

    if not isinstance(user, UserRecord):
        return 0.0

    if not isinstance(requirements, UserRequirements):
        return 0.0

    checks: List[bool] = []

    if requirements.require_user_id:
        checks.append(bool(user.user_id))

    if requirements.require_email:
        checks.append(bool(user.email))

    if requirements.require_display_name:
        checks.append(bool(user.display_name))

    if requirements.require_active_status:
        checks.append(user.status == UserStatus.ACTIVE)

    if requirements.require_mode:
        checks.append(user.mode != UserMode.UNKNOWN)

    if requirements.require_locale:
        checks.append(bool(user.locale))

    if requirements.require_timezone:
        checks.append(bool(user.timezone))

    if requirements.require_country:
        checks.append(bool(user.country))

    if not checks:
        return 1.0

    return sum(1.0 for item in checks if item) / len(checks)


# ============================================================================
# USER CONFIDENCE
# ============================================================================

def calculate_user_confidence(
    user: UserRecord,
) -> float:
    """
    Calculate confidence in the integrity of the user-domain record.

    Confidence reflects record quality, not user trustworthiness and not
    authentication confidence.
    """

    if not isinstance(user, UserRecord):
        return 0.0

    score = 1.0

    if not user.user_id:
        score -= 0.35

    if not user.email:
        score -= 0.25

    if user.status == UserStatus.UNKNOWN:
        score -= 0.15

    if user.mode == UserMode.UNKNOWN:
        score -= 0.10

    if not user.created_at:
        score -= 0.05

    if not isinstance(user.metadata, dict):
        score -= 0.10

    return max(0.0, min(1.0, score))


# ============================================================================
# USER QUALITY
# ============================================================================

def calculate_user_quality(
    completeness_score: float,
    confidence_score: float,
) -> float:
    """
    Calculate user-record quality.

    Quality model:
        Completeness = 60%
        Confidence   = 40%

    This score represents record quality only.
    """

    completeness = max(0.0, min(1.0, float(completeness_score)))
    confidence = max(0.0, min(1.0, float(confidence_score)))

    return (
        (completeness * 0.60)
        + (confidence * 0.40)
    )


# ============================================================================
# USER DATA STATE
# ============================================================================

def determine_user_data_state(
    user: UserRecord,
    requirements_met: bool,
    completeness_score: float,
) -> str:
    """
    Determine the data state of the user record.
    """

    if not isinstance(user, UserRecord):
        return "INVALID"

    if user.status == UserStatus.INVALID:
        return "INVALID"

    if user.status == UserStatus.DELETED:
        return "PARTIAL"

    if completeness_score <= 0.0:
        return "MISSING"

    if not requirements_met:
        return "PARTIAL"

    if completeness_score < 1.0:
        return "PARTIAL"

    return "COMPLETE"


# ============================================================================
# USER READINESS
# ============================================================================

def determine_user_readiness(
    user: UserRecord,
    requirements: UserRequirements,
    requirements_met: bool,
    completeness_score: float,
    confidence_score: float,
    quality_score: float,
) -> str:
    """
    Determine user-record readiness for downstream application use.

    This does not authorize login, trading, execution, billing or
    entitlement.
    """

    if not isinstance(user, UserRecord):
        return "BLOCKED"

    if user.status in {
        UserStatus.INVALID,
        UserStatus.DELETED,
        UserStatus.DISABLED,
    }:
        return "BLOCKED"

    if quality_score < 0.50:
        return "NOT_READY"

    if not requirements_met:
        if quality_score >= requirements.minimum_quality:
            return "CONDITIONALLY_READY"
        return "NOT_READY"

    if completeness_score < requirements.minimum_completeness:
        return "CONDITIONALLY_READY"

    if confidence_score < requirements.minimum_confidence:
        return "CONDITIONALLY_READY"

    if quality_score < requirements.minimum_quality:
        return "CONDITIONALLY_READY"

    if user.status == UserStatus.SUSPENDED:
        return "BLOCKED"

    return "READY"


# ============================================================================
# USER ASSESSMENT
# ============================================================================

def assess_user(
    user: UserRecord,
    requirements: Optional[UserRequirements] = None,
) -> UserAssessment:
    """
    Produce a complete user-domain assessment.
    """

    if requirements is None:
        requirements = build_user_requirements()

    if not isinstance(user, UserRecord):
        return UserAssessment(
            status=UserStatus.INVALID,
            data_state="INVALID",
            readiness="BLOCKED",
            completeness_score=0.0,
            confidence_score=0.0,
            quality_score=0.0,
            requirements_met=False,
            flags=["invalid_user_record"],
            metadata={
                "assessment_only": True,
                "authentication": False,
                "billing": False,
                "subscription": False,
                "entitlement": False,
                "intelligence_generation": False,
                "decision_generation": False,
                "d13_mutation": False,
                "risk_generation": False,
                "cas_override": False,
                "execution": False,
            },
        )

    requirements_met, flags = evaluate_user_requirements(
        user,
        requirements,
    )

    completeness_score = calculate_user_completeness(
        user,
        requirements,
    )

    confidence_score = calculate_user_confidence(user)

    quality_score = calculate_user_quality(
        completeness_score,
        confidence_score,
    )

    data_state = determine_user_data_state(
        user,
        requirements_met,
        completeness_score,
    )

    readiness = determine_user_readiness(
        user,
        requirements,
        requirements_met,
        completeness_score,
        confidence_score,
        quality_score,
    )

    if user.status == UserStatus.SUSPENDED:
        flags.append("user_suspended")

    if user.status == UserStatus.PENDING:
        flags.append("user_pending")

    if user.status == UserStatus.DISABLED:
        flags.append("user_disabled")

    return UserAssessment(
        status=user.status,
        completeness_score=round(completeness_score, 6),
        confidence_score=round(confidence_score, 6),
        quality_score=round(quality_score, 6),
        requirements_met=requirements_met,
        data_state=data_state,
        readiness=readiness,
        flags=sorted(set(flags)),
        metadata={
            "assessment_only": True,
            "record_quality_only": True,
            "authentication": False,
            "credential_validation": False,
            "billing": False,
            "subscription": False,
            "entitlement": False,
            "intelligence_generation": False,
            "decision_generation": False,
            "d13_mutation": False,
            "risk_generation": False,
            "risk_override": False,
            "cas_generation": False,
            "cas_override": False,
            "execution": False,
            "upstream_mutation": False,
        },
    )


