def _user_serialize_datetime(value: Any) -> Optional[str]:
    if value is None:
        return None
    if isinstance(value, datetime):
        return value.isoformat()
    return str(value)


def _user_serialize_value(value: Any) -> Any:
    if isinstance(value, Enum):
        return value.value
    if isinstance(value, datetime):
        return value.isoformat()
    if isinstance(value, dict):
        return {str(k): _user_serialize_value(v) for k, v in value.items()}
    if isinstance(value, (list, tuple)):
        return [_user_serialize_value(v) for v in value]
    if hasattr(value, "__dataclass_fields__"):
        return {
            name: _user_serialize_value(getattr(value, name))
            for name in value.__dataclass_fields__
        }
    return value


def serialize_user_request(request: UserRequest) -> Dict[str, Any]:
    return _user_serialize_value(request)


