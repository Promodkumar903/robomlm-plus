def validate_user_registry(
    registry: UserRegistry,
) -> UserContractValidation:
    """
    Validate the structural integrity of the user registry.
    """

    errors: List[str] = []
    warnings: List[str] = []

    if not isinstance(registry, UserRegistry):
        return UserContractValidation(
            status=UserContractStatus.INVALID,
            valid=False,
            errors=["registry must be UserRegistry"],
        )

    seen: set[str] = set()

    for user_id, entry in registry._entries.items():
        if not user_id:
            errors.append("registry contains empty user_id")

        if user_id in seen:
            errors.append(
                f"duplicate registry user_id: {user_id}"
            )

        seen.add(user_id)

        if not isinstance(entry, UserRegistryEntry):
            errors.append(
                f"invalid registry entry: {user_id}"
            )
            continue

        if entry.user_id != user_id:
            errors.append(
                f"registry key mismatch: {user_id}"
            )

        if not isinstance(
            entry.reference,
            UserReference,
        ):
            errors.append(
                f"invalid user reference: {user_id}"
            )

    if not registry._entries:
        warnings.append("user registry is empty")

    valid = len(errors) == 0

    return UserContractValidation(
        status=(
            UserContractStatus.READY
            if valid
            else UserContractStatus.INVALID
        ),
        valid=valid,
        errors=errors,
        warnings=warnings,
        metadata={
            "registry_validation": True,
            "authentication": False,
            "billing": False,
            "subscription": False,
            "intelligence_generation": False,
            "decision_generation": False,
            "d13_mutation": False,
            "risk_override": False,
            "cas_override": False,
            "execution": False,
        },
    )


def user_registry_health(
    registry: UserRegistry,
) -> Dict[str, Any]:
    """
    Return lightweight registry health information.
    """

    validation = validate_user_registry(registry)

    return {
        "healthy": validation.valid,
        "engine": USER_SERVICE_ENGINE,
        "version": USER_SERVICE_VERSION,
        "count": registry.count()
        if isinstance(registry, UserRegistry)
        else 0,
        "errors": list(validation.errors),
        "warnings": list(validation.warnings),
    }


