def collect_user_restrictions(
    user: UserRecord,
    assessment: UserAssessment,
) -> List[str]:
    """
    Collect user-domain restrictions only.
    """

    restrictions: List[str] = []

    if not isinstance(user, UserRecord):
        restrictions.append("INVALID_USER")

    if not isinstance(assessment, UserAssessment):
        restrictions.append("INVALID_ASSESSMENT")
        return restrictions

    if assessment.readiness == "CONDITIONALLY_READY":
        restrictions.append("CONDITIONAL_READINESS")

    if assessment.readiness == "NOT_READY":
        restrictions.append("NOT_READY")

    if assessment.readiness == "BLOCKED":
        restrictions.append("BLOCKED_USER")

    if user.status == UserStatus.SUSPENDED:
        restrictions.append("SUSPENDED_USER")

    if user.status == UserStatus.PENDING:
        restrictions.append("PENDING_USER")

    if not assessment.requirements_met:
        restrictions.append("REQUIREMENTS_INCOMPLETE")

    return list(dict.fromkeys(restrictions))


def collect_user_flags(
    user: UserRecord,
    assessment: UserAssessment,
) -> List[str]:
    """
    Collect user-domain assessment flags.
    """

    flags: List[str] = []

    if not isinstance(user, UserRecord):
        flags.append("INVALID_USER")
        return flags

    if not isinstance(assessment, UserAssessment):
        flags.append("INVALID_ASSESSMENT")
        return flags

    flags.extend(
        str(flag)
        for flag in assessment.flags
        if _user_text(flag)
    )

    if user.status == UserStatus.SUSPENDED:
        flags.append("USER_SUSPENDED")

    if user.status == UserStatus.DISABLED:
        flags.append("USER_DISABLED")

    if user.status == UserStatus.DELETED:
        flags.append("USER_DELETED")

    if user.status == UserStatus.INVALID:
        flags.append("USER_INVALID")

    return list(dict.fromkeys(flags))


def build_user_presentation(
    user: UserRecord,
    assessment: UserAssessment,
    decision: UserDecision,
) -> UserPresentation:
    """
    Build presentation state from already assessed user-domain data.
    """

    flags = collect_user_flags(user, assessment)
    restrictions = collect_user_restrictions(
        user,
        assessment,
    )

    return UserPresentation(
        user_id=_user_text(user.user_id),
        display_name=_user_text(user.display_name),
        email=_user_text(user.email),
        status=user.status,
        mode=user.mode,
        readiness=_user_text(
            assessment.readiness,
            "NOT_READY",
        ),
        decision=decision,
        quality_score=float(
            max(
                0.0,
                min(1.0, assessment.quality_score),
            )
        ),
        flags=flags,
        restrictions=restrictions,
        metadata={
            "presentation_only": True,
            "user_domain": True,
            "authentication": False,
            "billing": False,
            "subscription": False,
            "entitlement": False,
            "intelligence_generation": False,
            "decision_generation": False,
            "d13_authority": False,
            "risk_generation": False,
            "cas_generation": False,
            "execution": False,
        },
    )


def resolve_user(
    request: UserRequest,
    user: UserRecord,
    requirements: Optional[UserRequirements] = None,
    rules: Optional[UserResolutionRules] = None,
) -> UserResult:
    """
    Resolve a user-domain record into a presentation-safe result.

    Resolution does not authenticate, authorize external systems,
    generate trading decisions, modify D13, generate risk, invoke CAS,
    authorize execution, or create orders.
    """

    if requirements is None:
        requirements = build_user_requirements()

    if rules is None:
        rules = UserResolutionRules()

    result = UserResult(
        request=request,
        user=user,
        metadata={
            "resolution": True,
            "user_domain": True,
            "authentication": False,
            "billing": False,
            "subscription": False,
            "entitlement": False,
            "intelligence_generation": False,
            "decision_generation": False,
            "d13_mutation": False,
            "risk_generation": False,
            "risk_override": False,
            "cas_generation": False,
            "cas_override": False,
            "execution": False,
            "order_creation": False,
            "position_modification": False,
        },
    )

    # ------------------------------------------------------------------
    # REQUEST VALIDATION
    # ------------------------------------------------------------------

    request_validation = validate_user_request(request)

    if not request_validation.valid:
        result.resolution = UserResolutionStatus.BLOCKED
        result.decision = UserDecision.BLOCK
        result.flags = ["INVALID_REQUEST"]
        result.restrictions = list(request_validation.errors)
        result.metadata["request_valid"] = False
        result.authority_valid = False

        return result

    result.metadata["request_valid"] = True

    # ------------------------------------------------------------------
    # USER VALIDATION
    # ------------------------------------------------------------------

    if not isinstance(user, UserRecord):
        result.resolution = UserResolutionStatus.BLOCKED
        result.decision = UserDecision.BLOCK
        result.flags = ["INVALID_USER"]
        result.restrictions = ["INVALID_USER"]
        result.authority_valid = False

        return result

    # ------------------------------------------------------------------
    # AUTHORITY VALIDATION
    # ------------------------------------------------------------------

    authority = validate_user_service_authority()

    if not isinstance(
        authority,
        UserContractValidation,
    ):
        result.resolution = UserResolutionStatus.BLOCKED
        result.decision = UserDecision.BLOCK
        result.flags = ["INVALID_AUTHORITY_RESULT"]
        result.restrictions = ["AUTHORITY_VALIDATION_FAILED"]
        result.authority_valid = False

        return result

    result.authority_valid = bool(authority.valid)

    result.metadata["authority_status"] = (
        authority.status.value
        if isinstance(authority.status, Enum)
        else _user_text(authority.status)
    )

    if not authority.valid:
        result.resolution = UserResolutionStatus.BLOCKED
        result.decision = UserDecision.BLOCK
        result.flags = ["AUTHORITY_INVALID"]
        result.restrictions = list(authority.errors)
        return result

    # ------------------------------------------------------------------
    # ASSESSMENT
    # ------------------------------------------------------------------

    assessment = assess_user(
        user,
        requirements,
    )

    result.assessment = assessment
    result.reference = build_user_reference(user)

    # ------------------------------------------------------------------
    # HARD BLOCK CONDITIONS
    # ------------------------------------------------------------------

    if user.status in {
        UserStatus.INVALID,
        UserStatus.DELETED,
        UserStatus.DISABLED,
    }:
        if rules.block_when_invalid or (
            user.status == UserStatus.DISABLED
            and rules.block_when_disabled
        ) or (
            user.status == UserStatus.DELETED
            and rules.block_when_deleted
        ):
            result.resolution = UserResolutionStatus.BLOCKED
            result.decision = UserDecision.BLOCK

            result.flags = collect_user_flags(
                user,
                assessment,
            )

            result.restrictions = collect_user_restrictions(
                user,
                assessment,
            )

            result.presentation = build_user_presentation(
                user,
                assessment,
                result.decision,
            )

            return result

    if (
        user.status == UserStatus.SUSPENDED
        and rules.block_when_suspended
    ):
        result.resolution = UserResolutionStatus.BLOCKED
        result.decision = UserDecision.BLOCK

        result.flags = collect_user_flags(
            user,
            assessment,
        )

        result.restrictions = collect_user_restrictions(
            user,
            assessment,
        )

        result.presentation = build_user_presentation(
            user,
            assessment,
            result.decision,
        )

        return result

    # ------------------------------------------------------------------
    # READINESS RESOLUTION
    # ------------------------------------------------------------------

    readiness = _user_text(
        assessment.readiness,
        "NOT_READY",
    )

    quality_score = float(
        max(
            0.0,
            min(1.0, assessment.quality_score),
        )
    )

    if readiness == "READY":
        if (
            rules.allow_when_ready
            and quality_score >= rules.minimum_quality
        ):
            result.resolution = UserResolutionStatus.RESOLVED
            result.decision = UserDecision.ALLOW

    elif readiness == "CONDITIONALLY_READY":
        if rules.allow_when_conditionally_ready:
            result.resolution = UserResolutionStatus.CONDITIONAL
            result.decision = UserDecision.ALLOW_WITH_RESTRICTION
        else:
            result.resolution = UserResolutionStatus.REVIEW_REQUIRED
            result.decision = UserDecision.REVIEW_REQUIRED

    elif readiness == "NOT_READY":
        if rules.review_when_not_ready:
            result.resolution = UserResolutionStatus.REVIEW_REQUIRED
            result.decision = UserDecision.REVIEW_REQUIRED
        else:
            result.resolution = UserResolutionStatus.BLOCKED
            result.decision = UserDecision.BLOCK

    else:
        result.resolution = UserResolutionStatus.REVIEW_REQUIRED
        result.decision = UserDecision.REVIEW_REQUIRED

    # ------------------------------------------------------------------
    # FLAGS / RESTRICTIONS / PRESENTATION
    # ------------------------------------------------------------------

    result.flags = collect_user_flags(
        user,
        assessment,
    )

    result.restrictions = collect_user_restrictions(
        user,
        assessment,
    )

    result.presentation = build_user_presentation(
        user,
        assessment,
        result.decision,
    )

    result.metadata.update(
        {
            "readiness": readiness,
            "quality_score": quality_score,
            "requirements_met": bool(
                assessment.requirements_met
            ),
            "action_authority": False,
            "execution_authority": False,
            "order_authority": False,
            "position_authority": False,
        }
    )

    return result


def validate_user_result(
    result: UserResult,
) -> List[str]:
    """
    Validate user-domain resolution result.
    """

    errors: List[str] = []

    if not isinstance(result, UserResult):
        return ["result must be a UserResult"]

    if result.request is not None:
        errors.extend(
            validate_user_request_integrity(
                result.request
            )
        )

    if result.reference is not None:
        errors.extend(
            validate_user_reference_integrity(
                result.reference
            )
        )

    if result.user is not None:
        errors.extend(
            validate_user_record_integrity(
                result.user
            )
        )

    if result.assessment is not None:
        errors.extend(
            validate_user_assessment_integrity(
                result.assessment
            )
        )

    if result.presentation is not None:
        if not isinstance(
            result.presentation,
            UserPresentation,
        ):
            errors.append(
                "presentation must be UserPresentation"
            )

    if not isinstance(
        result.decision,
        UserDecision,
    ):
        errors.append(
            "decision must be UserDecision"
        )

    if not isinstance(
        result.resolution,
        UserResolutionStatus,
    ):
        errors.append(
            "resolution must be UserResolutionStatus"
        )

    if not isinstance(result.flags, list):
        errors.append("flags must be a list")

    if not isinstance(result.restrictions, list):
        errors.append(
            "restrictions must be a list"
        )

    if not isinstance(result.authority_valid, bool):
        errors.append(
            "authority_valid must be boolean"
        )

    if not isinstance(result.metadata, dict):
        errors.append(
            "metadata must be a dictionary"
        )

    return errors# ============================================================================
