# ============================================================================
# AUTHORITY VALIDATION
# ============================================================================

def validate_user_service_authority() -> UserContractValidation:
    """
    Validate that the user service has not been granted forbidden
    cross-domain authority.
    """

    forbidden_true = [
        key
        for key, value in USER_SERVICE_AUTHORITY.items()
        if key not in {
            "user_domain_authority",
            "user_lifecycle_authority",
            "user_contract_authority",
            "user_metadata_authority",
        }
        and value is True
    ]

    if forbidden_true:
        return UserContractValidation(
            status=UserContractStatus.INVALID,
            valid=False,
            errors=[
                f"forbidden authority enabled: {key}"
                for key in forbidden_true
            ],
            metadata={
                "authority_validation": True,
            },
        )

    return UserContractValidation(
        status=UserContractStatus.READY,
        valid=True,
        warnings=[],
        metadata={
            "authority_validation": True,
            "cross_domain_authority": False,
            "d13_authority": False,
            "risk_override": False,
            "cas_override": False,
            "execution": False,
        },
    )
