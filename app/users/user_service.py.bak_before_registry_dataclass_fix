) -> List[str]:
    errors: List[str] = []

    if not isinstance(assessment, UserAssessment):
        return ["assessment must be a UserAssessment"]

    for field_name in (
        "completeness_score",
        "confidence_score",
        "quality_score",
    ):
        value = getattr(assessment, field_name)
        if not isinstance(value, (int, float)):
            errors.append(f"{field_name} must be numeric")
        elif not 0.0 <= float(value) <= 1.0:
            errors.append(f"{field_name} must be between 0 and 1")

    valid_states = {
        "COMPLETE",
        "PARTIAL",
        "MISSING",
        "INVALID",
    }
    valid_readiness = {
        "READY",
        "CONDITIONALLY_READY",
        "NOT_READY",
        "BLOCKED",
    }

    if assessment.data_state not in valid_states:
        errors.append("data_state is invalid")

    if assessment.readiness not in valid_readiness:
        errors.append("readiness is invalid")

    if not isinstance(assessment.requirements_met, bool):
        errors.append("requirements_met must be boolean")

    if not isinstance(assessment.flags, list):
        errors.append("flags must be a list")

    if not isinstance(assessment.metadata, dict):
        errors.append("metadata must be a dictionary")

    return errors


def validate_user_result_integrity(
    result: UserResult,
) -> List[str]:
    errors: List[str] = []

    if not isinstance(result, UserResult):
        return ["result must be a UserResult"]

    if result.request is not None:
        errors.extend(validate_user_request_integrity(result.request))

    if result.reference is not None:
        errors.extend(validate_user_reference_integrity(result.reference))

    if result.user is not None:
        errors.extend(validate_user_record_integrity(result.user))

    if result.assessment is not None:
        errors.extend(validate_user_assessment_integrity(result.assessment))

    if not isinstance(result.authority_valid, bool):
        errors.append("authority_valid must be boolean")

    if not isinstance(result.flags, list):
        errors.append("flags must be a list")

    if not isinstance(result.restrictions, list):
        errors.append("restrictions must be a list")

    if not isinstance(result.metadata, dict):
        errors.append("metadata must be a dictionary")

    return errors


def validate_user_registry_snapshot_integrity(
    snapshot: UserRegistrySnapshot,
) -> List[str]:
    errors: List[str] = []

    if not isinstance(snapshot, UserRegistrySnapshot):
        return ["snapshot must be a UserRegistrySnapshot"]

    if snapshot.engine != USER_SERVICE_ENGINE:
        errors.append("engine mismatch")

    if snapshot.version != USER_SERVICE_VERSION:
        errors.append("version mismatch")

    if not isinstance(snapshot.entries, list):
        errors.append("entries must be a list")
    else:
        for entry in snapshot.entries:
            if not isinstance(entry, UserRegistryEntry):
                errors.append("registry contains invalid entry")
                continue

            if not _user_text(entry.user_id):
                errors.append("registry entry user_id is required")

            if not isinstance(entry.reference, UserReference):
                errors.append("registry entry reference is invalid")

            if not isinstance(entry.active, bool):
                errors.append(
                    f"registry entry {entry.user_id} active must be boolean"
                )

    if snapshot.count != len(snapshot.entries):
        errors.append("snapshot count mismatch")

    return errors


def validate_user_service_result_integrity(
    result: UserServiceResult,
) -> List[str]:
    errors: List[str] = []

    if not isinstance(result, UserServiceResult):
        return ["result must be a UserServiceResult"]

    if result.reference is not None:
        errors.extend(validate_user_reference_integrity(result.reference))

    if result.user is not None:
        errors.extend(validate_user_record_integrity(result.user))

    if result.validation is not None:
        if not isinstance(
            result.validation,
            UserContractValidation,
        ):
            errors.append("validation is invalid")

    if not isinstance(result.success, bool):
        errors.append("success must be boolean")

    if not isinstance(result.errors, list):
        errors.append("errors must be a list")

    if not isinstance(result.warnings, list):
        errors.append("warnings must be a list")

    if not isinstance(result.metadata, dict):
        errors.append("metadata must be a dictionary")

    return errors


def user_service_summary(
    user: Optional[UserRecord] = None,
    assessment: Optional[UserAssessment] = None,
    result: Optional[UserResult] = None,
) -> Dict[str, Any]:
    summary: Dict[str, Any] = {
        "engine": USER_SERVICE_ENGINE,
        "version": USER_SERVICE_VERSION,
        "user_id": None,
        "status": None,
        "mode": None,
        "readiness": None,
        "decision": None,
        "quality_score": None,
        "requirements_met": None,
        "authority_valid": None,
        "flags": [],
        "restrictions": [],
    }

    if user is not None:
        summary["user_id"] = user.user_id
        summary["status"] = user.status.value
        summary["mode"] = user.mode.value

    if assessment is not None:
        summary["readiness"] = assessment.readiness
        summary["quality_score"] = assessment.quality_score
        summary["requirements_met"] = assessment.requirements_met
        summary["flags"] = list(assessment.flags)

    if result is not None:
        summary["authority_valid"] = result.authority_valid

        if result.presentation is not None:
            summary["readiness"] = result.presentation.readiness
            summary["decision"] = result.presentation.decision.value
            summary["quality_score"] = result.presentation.quality_score
            summary["flags"] = list(result.presentation.flags)
            summary["restrictions"] = list(
                result.presentation.restrictions
            )

    return summary


def user_service_integrity_check(
    user: Optional[UserRecord] = None,
    reference: Optional[UserReference] = None,
    assessment: Optional[UserAssessment] = None,
    result: Optional[UserResult] = None,
) -> Dict[str, Any]:
    errors: List[str] = []

    if user is not None:
        errors.extend(validate_user_record_integrity(user))

    if reference is not None:
        errors.extend(validate_user_reference_integrity(reference))

    if assessment is not None:
        errors.extend(validate_user_assessment_integrity(assessment))

    if result is not None:
        errors.extend(validate_user_result_integrity(result))

    return {
        "engine": USER_SERVICE_ENGINE,
        "version": USER_SERVICE_VERSION,
        "valid": not errors,
        "errors": errors,
        "checked_at": datetime.now(timezone.utc).isoformat(),
    }


def user_service_operational_check() -> Dict[str, Any]:
    service = get_user_service()

    authority = service.authority()

    registry_health = service.health()

    authority_valid = all(
        value is True
        for key, value in authority.items()
        if key.endswith("_authority")
        and key not in {
            "authentication_authority",
            "credential_authority",
            "security_override_authority",
            "billing_authority",
            "subscription_authority",
            "entitlement_authority",
            "market_data_authority",
            "evidence_generation_authority",
            "intelligence_generation_authority",
            "market_context_generation_authority",
            "decision_generation_authority",
            "d13_authority",
            "risk_generation_authority",
            "cas_generation_authority",
            "execution_authority",
            "order_authority",
            "position_authority",
            "upstream_mutation_authority",
        }
    )

    return {
        "engine": USER_SERVICE_ENGINE,
        "version": USER_SERVICE_VERSION,
        "operational": bool(
            authority_valid
            and registry_health.get("healthy", False)
        ),
        "authority_valid": authority_valid,
        "registry": registry_health,
        "user_count": service.count(),
        "checked_at": datetime.now(timezone.utc).isoformat(),
    }


