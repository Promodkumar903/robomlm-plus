class UserRegistry:
    """
    In-memory user-domain registry.

    Persistence/authentication storage is intentionally outside this class.
    """

    def __init__(self) -> None:
        self._entries: Dict[str, UserRegistryEntry] = {}

    def exists(self, user_id: str) -> bool:
        key = _user_text(user_id)
        return bool(key) and key in self._entries

    def get(self, user_id: str) -> Optional[UserReference]:
        key = _user_text(user_id)

        entry = self._entries.get(key)

        if entry is None or not entry.active:
            return None

        return entry.reference

    def get_entry(
        self,
        user_id: str,
    ) -> Optional[UserRegistryEntry]:
        key = _user_text(user_id)

        entry = self._entries.get(key)

        if entry is None or not entry.active:
            return None

        return entry

    def add(
        self,
        user: UserRecord,
    ) -> UserReference:
        if not isinstance(user, UserRecord):
            raise TypeError("user must be UserRecord")

        user_id = _user_text(user.user_id)

        if not user_id:
            raise ValueError("user_id is required")

        if self.exists(user_id):
            raise ValueError(
                f"user already exists: {user_id}"
            )

        reference = build_user_reference(user)
        now = datetime.now(timezone.utc)

        self._entries[user_id] = UserRegistryEntry(
            user_id=user_id,
            reference=reference,
            created_at=now,
            updated_at=now,
            active=True,
            metadata={
                "source": "app.users.user_service",
                "domain_registry": True,
            },
        )

        return reference

    def replace(
        self,
        user: UserRecord,
    ) -> UserReference:
        if not isinstance(user, UserRecord):
            raise TypeError("user must be UserRecord")

        user_id = _user_text(user.user_id)

        if not user_id:
            raise ValueError("user_id is required")

        reference = build_user_reference(user)
        now = datetime.now(timezone.utc)

        existing = self._entries.get(user_id)

        created_at = (
            existing.created_at
            if existing is not None
            else now
        )

        self._entries[user_id] = UserRegistryEntry(
            user_id=user_id,
            reference=reference,
            created_at=created_at,
            updated_at=now,
            active=True,
            metadata={
                "source": "app.users.user_service",
                "domain_registry": True,
            },
        )

        return reference

    def remove(
        self,
        user_id: str,
    ) -> bool:
        key = _user_text(user_id)

        entry = self._entries.get(key)

        if entry is None:
            return False

        entry.active = False
        entry.updated_at = datetime.now(timezone.utc)

        return True

    def list_references(self) -> List[UserReference]:
        return [
            entry.reference
            for entry in self._entries.values()
            if entry.active
        ]

    def snapshot(self) -> UserRegistrySnapshot:
        entries = [
            entry
            for entry in self._entries.values()
            if entry.active
        ]

        return UserRegistrySnapshot(
            engine=USER_SERVICE_ENGINE,
            version=USER_SERVICE_VERSION,
            entries=list(entries),
            count=len(entries),
            captured_at=datetime.now(timezone.utc),
            metadata={
                "registry_snapshot": True,
                "authentication_storage": False,
                "billing_storage": False,
            },
        )

    def count(self) -> int:
        return sum(
            1
            for entry in self._entries.values()
            if entry.active
        )


