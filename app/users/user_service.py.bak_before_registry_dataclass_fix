class UserService:
    """
    Application service for user-domain operations.

    This service owns user-domain orchestration only.
    """

    def __init__(
        self,
        registry: Optional[UserRegistry] = None,
    ) -> None:
        self.registry = registry or UserRegistry()

    def create(
        self,
        request: UserRequest,
    ) -> UserServiceResult:
        """
        Create a user-domain record and register its reference.
        """

        validation = validate_user_request(request)

        if not validation.valid:
            return UserServiceResult(
                request_id=request.request_id
                if isinstance(request, UserRequest)
                else "",
                validation=validation,
                success=False,
                errors=list(validation.errors),
                warnings=list(validation.warnings),
            )

        if not request.user_id:
            return UserServiceResult(
                request_id=request.request_id,
                validation=validation,
                success=False,
                errors=["user_id is required for creation"],
                warnings=list(validation.warnings),
            )

        if self.registry.exists(request.user_id):
            return UserServiceResult(
                request_id=request.request_id,
                validation=validation,
                success=False,
                errors=[
                    f"user already exists: {request.user_id}"
                ],
                warnings=list(validation.warnings),
            )

        now = datetime.now(timezone.utc)

        user = UserRecord(
            user_id=request.user_id,
            email=request.email,
            display_name=request.display_name,
            status=(
                request.status
                if request.status != UserStatus.UNKNOWN
                else UserStatus.PENDING
            ),
            mode=request.mode,
            locale=request.locale,
            timezone=request.timezone,
            country=request.country,
            created_at=now,
            updated_at=now,
            lifecycle_event=UserLifecycleEvent.CREATED,
            metadata=dict(request.metadata),
        )

        reference = self.registry.add(user)

        return UserServiceResult(
            request_id=request.request_id,
            reference=reference,
            user=user,
            validation=validation,
            success=True,
            event=UserLifecycleEvent.CREATED,
            warnings=list(validation.warnings),
            metadata={
                "operation": "create",
                "user_domain": True,
                "authentication": False,
                "billing": False,
                "subscription": False,
                "entitlement": False,
                "intelligence_generation": False,
                "decision_generation": False,
                "d13_mutation": False,
                "risk_generation": False,
                "risk_override": False,
                "cas_generation": False,
                "cas_override": False,
                "execution": False,
            },
        )

    def get(
        self,
        user_id: str,
    ) -> Optional[UserReference]:
        return self.registry.get(user_id)

    def get_entry(
        self,
        user_id: str,
    ) -> Optional[UserRegistryEntry]:
        return self.registry.get_entry(user_id)

    def register(
        self,
        user: UserRecord,
    ) -> UserReference:
        return self.registry.replace(user)

    def assess(
        self,
        user: UserRecord,
        requirements: Optional[UserRequirements] = None,
    ) -> UserAssessment:
        return assess_user(
            user,
            requirements,
        )

    def resolve(
        self,
        request: UserRequest,
        user: UserRecord,
        requirements: Optional[UserRequirements] = None,
        rules: Optional[UserResolutionRules] = None,
    ) -> UserResult:
        return resolve_user(
            request,
            user,
            requirements,
            rules,
        )

    def update_lifecycle(
        self,
        user: UserRecord,
        event: UserLifecycleEvent,
    ) -> UserServiceResult:
        """
        Apply a validated lifecycle transition.
        """

        validation = validate_user_lifecycle_transition(
            user.status,
            event,
        )

        if not validation.valid:
            return UserServiceResult(
                request_id="",
                reference=build_user_reference(user),
                user=user,
                validation=validation,
                success=False,
                errors=list(validation.errors),
                warnings=list(validation.warnings),
            )

        updated_user = apply_user_lifecycle_event(
            user,
            event,
        )

        reference = self.registry.replace(
            updated_user,
        )

        return UserServiceResult(
            request_id="",
            reference=reference,
            user=updated_user,
            validation=validation,
            success=True,
            event=event,
            warnings=list(validation.warnings),
            metadata={
                "operation": "update_lifecycle",
                "user_domain": True,
                "authentication": False,
                "billing": False,
                "subscription": False,
                "entitlement": False,
                "intelligence_generation": False,
                "decision_generation": False,
                "d13_mutation": False,
                "risk_generation": False,
                "risk_override": False,
                "cas_generation": False,
                "cas_override": False,
                "execution": False,
            },
        )

    def list_references(self) -> List[UserReference]:
        return self.registry.list_references()

    def snapshot(self) -> UserRegistrySnapshot:
        return self.registry.snapshot()

    def count(self) -> int:
        return self.registry.count()

    def health(self) -> Dict[str, Any]:
        return user_registry_health(
            self.registry,
        )

    def authority(self) -> UserContractValidation:
        return validate_user_service_authority()


