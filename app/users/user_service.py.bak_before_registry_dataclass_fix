    UserStatus.SUSPENDED: {
        UserLifecycleEvent.REACTIVATED,
        UserLifecycleEvent.DISABLED,
        UserLifecycleEvent.DELETED,
    },
    UserStatus.DISABLED: {
        UserLifecycleEvent.REACTIVATED,
        UserLifecycleEvent.DELETED,
    },
    UserStatus.DELETED: {
        UserLifecycleEvent.DELETED,
    },
    UserStatus.UNKNOWN: {
        UserLifecycleEvent.CREATED,
    },
    UserStatus.INVALID: set(),
}
def apply_user_lifecycle_event(
    user: UserRecord,
    event: UserLifecycleEvent,
) -> UserRecord:
    """
    Apply an already-validated user lifecycle event.

    This function performs user-domain state transition only.

    It does NOT:
        - authenticate
        - authorize
        - modify billing
        - modify subscription
        - modify entitlement
        - generate intelligence
        - generate decisions
        - modify D13
        - modify risk
        - override CAS
        - execute orders
        - modify positions
    """

    if not isinstance(user, UserRecord):
        raise TypeError("user must be UserRecord")

    event = _user_enum(
        event,
        UserLifecycleEvent,
        UserLifecycleEvent.CREATED,
    )

    status_by_event = {
        UserLifecycleEvent.CREATED: UserStatus.PENDING,
        UserLifecycleEvent.ACTIVATED: UserStatus.ACTIVE,
        UserLifecycleEvent.UPDATED: user.status,
        UserLifecycleEvent.SUSPENDED: UserStatus.SUSPENDED,
        UserLifecycleEvent.REACTIVATED: UserStatus.ACTIVE,
        UserLifecycleEvent.DISABLED: UserStatus.DISABLED,
        UserLifecycleEvent.DELETED: UserStatus.DELETED,
    }

    new_status = status_by_event[event]

    now = datetime.now(timezone.utc)

    updated_user = UserRecord(
        user_id=user.user_id,
        email=user.email,
        display_name=user.display_name,
        status=new_status,
        mode=user.mode,
        locale=user.locale,
        timezone=user.timezone,
        country=user.country,
        created_at=user.created_at,
        updated_at=now,
        last_seen_at=user.last_seen_at,
        lifecycle_event=event,
        metadata=dict(user.metadata),
    )

    updated_user.metadata.update(
        {
            "lifecycle_event_applied": event.value,
            "lifecycle_transition": True,
            "authentication": False,
            "billing": False,
            "subscription": False,
            "entitlement": False,
            "intelligence_generation": False,
            "decision_generation": False,
            "d13_mutation": False,
            "risk_generation": False,
            "risk_override": False,
            "cas_generation": False,
            "cas_override": False,
            "execution": False,
        }
    )

    return updated_user


