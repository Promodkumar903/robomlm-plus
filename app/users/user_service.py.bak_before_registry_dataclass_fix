def validate_user_record_integrity(
    user: UserRecord,
) -> List[str]:
    errors: List[str] = []

    if not isinstance(user, UserRecord):
        return ["user must be a UserRecord"]

    if not _user_text(user.user_id):
        errors.append("user_id is required")

    if not _user_text(user.email):
        errors.append("email is required")
    elif "@" not in user.email:
        errors.append("email format is invalid")

    if not isinstance(user.status, UserStatus):
        errors.append("status is invalid")

    if not isinstance(user.mode, UserMode):
        errors.append("mode is invalid")

    if not isinstance(user.lifecycle_event, UserLifecycleEvent):
        errors.append("lifecycle_event is invalid")

    if user.created_at is None:
        errors.append("created_at is required")

    if user.updated_at is None:
        errors.append("updated_at is required")

    if not isinstance(user.metadata, dict):
        errors.append("metadata must be a dictionary")

    return errors


